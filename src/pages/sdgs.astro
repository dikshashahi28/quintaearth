---
// The 17 UN Sustainable Development Goals (design: "the spring", layouts/Spring.astro): the goals are the UN's,
// described in the one line the site has always carried for each; this page only says how many QuintaEarth
// Insights are tagged with each. One stop on the river per goal, then the UN's own reading.
import '../styles/spring-goals.css';
import Spring from '../layouts/Spring.astro';
import RiverRail from '../components/spring/RiverRail.astro';
import Bead from '../components/spring/Bead.astro';
import { goalReading, goals } from '../data/sdgs';
import { getStream } from '../lib/content';
import { page } from '../lib/url';

const stream = await getStream({ press: true });
const tagged = (n: number) => stream.filter((it) => it.sdgs.includes(n)).length;
---
<Spring title="UN Sustainable Development Goals" description="The 17 UN Sustainable Development Goals, and every QuintaEarth Insight tagged with each."
  scene="who-stone-1"
  say="The 17 UN goals" sub="Every Insight is tagged with the goals it serves">
  <RiverRail class="goals">
    {goals.map((g) => {
      const n = tagged(g.n);
      return (
        <Bead />
        <article class="sp-stop goal-row" id={`goal-${g.n}`}>
          <span class="num" aria-hidden="true">{g.n}</span>
          <div class="text">
            <h2><a href={page(`sdgs/goal-${g.n}`)}><span class="sr">Goal {g.n}: </span>{g.title}</a></h2>
            <p>{g.line}</p>
            <p class="tally">{n ? `${n} ${n === 1 ? 'Insight' : 'Insights'}` : 'Nothing tagged yet'}</p>
          </div>
        </article>
      );
    })}

    <Bead last />
    <section class="sp-stop end" aria-labelledby="reading-h">
      <h2 id="reading-h">Further reading</h2>
      <ul class="reading">{goalReading.map((r) => <li><a href={r.href} target="_blank" rel="noopener">{r.label}<svg class="ic" aria-hidden="true"><use href="#i-arrow-up-right" /></svg></a></li>)}</ul>
    </section>
  </RiverRail>
</Spring>
