---
// Contact (design: "the spring", layouts/Spring.astro): the scene, the two direct ways (email, the WhatsApp
// community), then the partner form as the doors' form: a step per bead, each bead lighting as its fields pass
// the form's own rules (scripts/partner-form.ts). Every "Ask for a proposal" door on /services lands here with
// ?offer=<slug>#partner, which renames the head and starts the purpose. Fields, rules, endpoint and payload are
// unchanged from the old form.
import Spring from '../layouts/Spring.astro';
import GoButton from '../components/members/forms/GoButton.astro';
import Icon from '../components/members/Icon.astro';
import { site } from '../data/site';

const companyTypes = [
  ['company', 'Company'],
  ['startup', 'Startup'],
  ['ngo', 'NGO'],
  ['pressure-group', 'Pressure group'],
  ['foundation', 'Foundation'],
  ['government', 'Government'],
  ['academic', 'Academic'],
  ['other', 'Other'],
] as const;
const rail = (ids: string, last = false) => ({ class: last ? 'qe-rail last' : 'qe-rail', 'data-for': ids });
---
<Spring current="contact" title="Contact" description="Write to QuintaEarth, join the Green Tech Community on WhatsApp, or partner with us on CSR."
  scene="scene-contact"
  say="Where sustainability is made, not performed." sub="Need any help with CSR? We will help">
  <div class="sp-ways">
    <a class="tlink" href={`mailto:${site.email}`}><svg class="ic" aria-hidden="true"><use href="#i-envelope" /></svg>{site.email}</a>
    <a class="tlink" href={site.whatsapp} target="_blank" rel="noopener"><svg class="ic" aria-hidden="true"><use href="#i-whatsapp" /></svg>Green Tech Community on WhatsApp</a>
  </div>

  <section class="sp-form" id="partner" aria-labelledby="partner-title">
    <h2 id="partner-title">Partner with us</h2>
    <p class="sub" id="partner-sub">Work with us on CSR that treats the earth as something made.</p>

    <form class="qe-form" id="partner-form" action="#" method="post" novalidate>
      <div class="qe-grid">
        <div {...rail('partner-company partner-type partner-website partner-place')} aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step">
          <div class="row2">
            <div class="field">
              <label for="partner-company">Company name</label>
              <input class="inp" id="partner-company" name="company" type="text" autocomplete="organization" maxlength="120" required aria-describedby="partner-company-error">
              <p class="err" id="partner-company-error"></p>
            </div>
            <div class="field">
              <label for="partner-type">Company type</label>
              <span class="selwrap">
                <select class="sel" id="partner-type" name="company_type" required aria-describedby="partner-type-error">
                  <option value="">Choose one</option>
                  {companyTypes.map(([value, label]) => <option value={value}>{label}</option>)}
                </select>
                <Icon name="expand_more" />
              </span>
              <p class="err" id="partner-type-error"></p>
            </div>
          </div>
          <div class="row2">
            <div class="field">
              <label for="partner-website">Website</label>
              <input class="inp" id="partner-website" name="website" type="url" autocomplete="url" placeholder="https://" maxlength="200" spellcheck="false" required aria-describedby="partner-website-error">
              <p class="err" id="partner-website-error"></p>
            </div>
            <div class="field">
              <label for="partner-place">Place</label>
              <input class="inp" id="partner-place" name="place" type="text" autocomplete="address-level2" maxlength="80" required aria-describedby="partner-place-error">
              <p class="err" id="partner-place-error"></p>
            </div>
          </div>
        </div>

        <div {...rail('partner-contact partner-designation partner-email partner-phone')} aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step">
          <div class="row2">
            <div class="field">
              <label for="partner-contact">Contact person name</label>
              <input class="inp" id="partner-contact" name="contact_name" type="text" autocomplete="name" maxlength="80" required aria-describedby="partner-contact-error">
              <p class="err" id="partner-contact-error"></p>
            </div>
            <div class="field">
              <label for="partner-designation">Designation</label>
              <input class="inp" id="partner-designation" name="designation" type="text" autocomplete="organization-title" maxlength="80" required aria-describedby="partner-designation-error">
              <p class="err" id="partner-designation-error"></p>
            </div>
          </div>
          <div class="row2">
            <div class="field">
              <label for="partner-email">Email</label>
              <input class="inp" id="partner-email" name="email" type="email" autocomplete="email" maxlength="100" spellcheck="false" required aria-describedby="partner-email-error">
              <p class="err" id="partner-email-error"></p>
            </div>
            <div class="field">
              <label for="partner-phone">Phone number</label>
              <input class="inp" id="partner-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="12" required aria-describedby="partner-phone-error">
              <p class="err" id="partner-phone-error"></p>
            </div>
          </div>
        </div>

        <div {...rail('partner-purpose partner-consent')} aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step">
          <div class="field">
            <label for="partner-purpose">Purpose</label>
            <textarea class="area" id="partner-purpose" name="purpose" rows="4" maxlength="400" required aria-describedby="partner-purpose-hint partner-purpose-error"></textarea>
            <p class="hint" id="partner-purpose-hint">20 to 400 characters.</p>
            <p class="err" id="partner-purpose-error"></p>
          </div>
          <div class="field">
            <label class="check" for="partner-consent">
              <input id="partner-consent" name="consent" type="checkbox" required aria-describedby="partner-consent-error">
              <span id="partner-consent-text">I agree to be contacted about this partnership.</span>
            </label>
            <p class="err" id="partner-consent-error"></p>
          </div>
        </div>

        <div {...rail('*', true)} aria-hidden="true"><span class="bead"></span></div>
        <div class="qe-step end">
          <div class="acts">
            <GoButton label="Send" />
            <p class="form-status" id="partner-status" role="status"></p>
          </div>
        </div>
      </div>
    </form>

    <div class="qe-grid" id="partner-thanks" tabindex="-1" hidden>
      <div class="qe-rail sent lit" aria-hidden="true"><span class="bead"></span></div>
      <div class="qe-sent" role="status">
        <h2>Thank you.</h2>
        <p>Our team will contact you soon.</p>
      </div>
    </div>
  </section>
</Spring>

<script>
  import { initPartnerForm } from '../scripts/partner-form';
  initPartnerForm();
</script>
