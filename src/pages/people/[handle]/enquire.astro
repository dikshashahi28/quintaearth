---
// Write to a person with a public page (people take enquiries too, 12 Oct). Senders must be signed in; signed-out
// visitors get a sign-in button. The person's email address never reaches this page: replies come through the
// dashboard and by email. ?sent=<id> shows the sent state after the post.
import { isEntityId } from '../../../lib/validate';
import { actions, isInputError } from 'astro:actions';
import Member from '../../../layouts/Member.astro';
import EnquireHead from '../../../components/members/enquiries/EnquireHead.astro';
import GoButton from '../../../components/members/forms/GoButton.astro';
import RailLight from '../../../components/members/forms/RailLight.astro';
import Icon from '../../../components/members/Icon.astro';
import { eq } from 'drizzle-orm';
import { db, schema } from '../../../db/client';
import { getPublicPerson } from '../../../db/queries/public';
import { myCompanies, myProfile } from '../../../db/queries/dashboard';
import { place as placeOf } from '../../../lib/labels';
import { fieldError } from '../../../components/members/enquiries/data';
import { actionErrorMessage } from '../../../components/members/forms/errors';
import '../../../styles/members/enquiries.css';

export const prerender = false;

const person = await getPublicPerson(Astro.params.handle ?? '');
if (!person) return new Response(null, { status: 404 });

const user = Astro.locals.user ?? null;
const sender = user ? await db.query.user.findFirst({ where: eq(schema.user.id, user.id), columns: { name: true, email: true } }) : null;
const here = `/people/${person.handle}/enquire`;
const result = Astro.getActionResult(actions.enquiries.send);
if (result?.data) return Astro.redirect(`${here}?sent=${result.data.id}`, 303);
const errors: Record<string, string | undefined> = {};
const emptyText: Record<string, string> = { subject: 'Add a subject.', message: 'Write at least a couple of sentences.' };
if (result?.error && isInputError(result.error)) for (const [k, v] of Object.entries(result.error.fields)) errors[k] = fieldError(v as string[] | undefined, emptyText[k] ?? 'Check this field.');
const shown = new Set(['subject', 'fromCompany', 'message']);
const hiddenError = !!result?.error && isInputError(result.error) && Object.keys(result.error.fields).some((k) => !shown.has(k));
const failed = result?.error && (!isInputError(result.error) || hiddenError) ? actionErrorMessage(result.error) : null;

let typed: Record<string, string> = {};
if (Astro.request.method === 'POST' && result?.error) {
  try { typed = Object.fromEntries([...(await Astro.request.formData()).entries()].filter((e): e is [string, string] => typeof e[1] === 'string')); } catch { typed = {}; }
}

const sentId = Astro.url.searchParams.get('sent');
const sentOk = !!user && !!sentId && isEntityId(sentId);
const own = !!user && (await myProfile(user.id))?.handle === person.handle;
const mine = user ? await myCompanies(user.id) : [];
const where = placeOf(person.city, person.country);
const nextUrl = Astro.url.pathname + Astro.url.search;
const message = typed.message ?? '';
---
<Member title={`Write to ${person.name}`} description={`Send ${person.name} a message on QuintaEarth.`} noindex current="directory">
  <div class="wide eqp">
    <EnquireHead name={person.name} imageKey={person.photoKey} href={`/people/${person.handle}`} where={where} />
    {sentOk ? (
        <div class="qe-grid eqp-state">
          <div class="qe-rail sent lit" aria-hidden="true"><span class="bead"></span></div>
          <div class="qe-sent" role="status">
            <h2>Enquiry sent</h2>
            <p>{person.name} will reply in your dashboard and by email.</p>
            <a class="tlink" href={`/dashboard/messages/${sentId}`}>Open the enquiry<Icon name="arrow_forward" /></a>
          </div>
        </div>
      ) : own ? (
        <div class="qe-grid eqp-state">
          <div class="qe-rail last" aria-hidden="true"><span class="bead"></span></div>
          <div class="qe-step end">
            <p class="eqp-say">This is your own page.</p>
            <a class="tlink" href="/dashboard/enquiries?inbox=me">Open your enquiries<Icon name="arrow_forward" /></a>
          </div>
        </div>
      ) : !user ? (
        <div class="qe-grid eqp-state">
          <div class="qe-rail last" aria-hidden="true"><span class="bead"></span></div>
          <div class="qe-step end">
            <p class="eqp-say">Sign in to message {person.name}. Replies come to your email.</p>
            <div class="acts"><a class="qe-btn" href={`/signin?next=${encodeURIComponent(nextUrl)}`}>Sign in to send<svg viewBox="0 0 256 256" aria-hidden="true"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg></a></div>
          </div>
        </div>
      ) : (
        <form class="qe-form eqp-form" method="POST" action={String(actions.enquiries.send)} data-rail-light>
          {failed && <p class="form-status bad" role="alert">{failed}</p>}
          <input type="hidden" name="toHandle" value={person.handle}>
          <div class="qe-grid">
            <div class="qe-rail" data-for="q-subject q-co" aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
            <div class="qe-step">
              <div class="row2">
                <div class="field">
                  <label for="q-subject">Subject</label>
                  <input class="inp" id="q-subject" name="subject" type="text" required minlength="3" maxlength="140" value={typed.subject ?? ''}
                    aria-invalid={errors.subject ? 'true' : undefined} aria-describedby="q-subject-error">
                  <p class="err" id="q-subject-error">{errors.subject}</p>
                </div>
                <div class="field">
                  <label for="q-co">Company <span class="opt">(optional)</span></label>
                  <input class="inp" id="q-co" name="fromCompany" type="text" autocomplete="organization" maxlength="120" value={typed.fromCompany ?? mine[0]?.name ?? ''}
                    aria-invalid={errors.fromCompany ? 'true' : undefined} aria-describedby="q-co-error">
                  <p class="err" id="q-co-error">{errors.fromCompany}</p>
                </div>
              </div>
            </div>
            <div class="qe-rail" data-for="q-msg" aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
            <div class="qe-step">
              <div class="field">
                <div class="labrow"><label for="q-msg">Message</label><span class="count" id="q-count">{message.length} / 4000</span></div>
                <textarea class="area tall" id="q-msg" name="message" required minlength="20" maxlength="4000"
                  aria-invalid={errors.message ? 'true' : undefined} aria-describedby="q-msg-error q-count">{message}</textarea>
                <p class="err" id="q-msg-error">{errors.message}</p>
              </div>
              <div class="eq-hp" aria-hidden="true">
                <label for="q-website">Leave this empty</label>
                <input id="q-website" name="website" type="text" tabindex="-1" autocomplete="off" value="">
              </div>
            </div>
            <div class="qe-rail last" data-for="q-subject q-co q-msg" aria-hidden="true"><span class="bead"></span></div>
            <div class="qe-step end">
              <div class="acts"><GoButton label="Send enquiry" /></div>
              <p class="note">{person.name} sees your name ({sender?.name || user.name}), email ({sender?.email ?? user.email}), company and message.</p>
            </div>
          </div>
        </form>
      )}
  </div>
  <RailLight />
</Member>

<script>
  // live character count; without JS the count shows what was there at load
  const area = document.querySelector<HTMLTextAreaElement>('#q-msg');
  const count = document.querySelector('#q-count');
  if (area && count) area.addEventListener('input', () => { count.textContent = `${area.value.length} / 4000`; });
</script>
