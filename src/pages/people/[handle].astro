---
// Public person page (design: Person, "the spring": styles/members/person.css). Only published profiles exist here; anything else is a 404.
import { and, inArray, eq } from 'drizzle-orm';
import Member from '../../layouts/Member.astro';
import PersonHead from '../../components/members/public/PersonHead.astro';
import Avatar from '../../components/members/Avatar.astro';
import IdentityMark from '../../components/members/IdentityMark.astro';
import { db, schema } from '../../db/client';
import { inChunks } from '../../db/chunks';
import { getPublicPerson } from '../../db/queries/public';
import { fileUrl } from '../../lib/storage-url';
import { absolute, page } from '../../lib/url';
import { industryLinks, ldJson, place, subLinks } from '../../lib/labels';
import '../../styles/members/person.css';

export const prerender = false;

const handle = Astro.params.handle ?? '';
const viewer = Astro.locals.user ?? null;
let person = await getPublicPerson(handle);
// a hidden profile: its owner gets a preview; everyone else the same 404 as a missing page
let preview = false;
if (!person && viewer && await db.query.profiles.findFirst({ where: and(eq(schema.profiles.handle, handle), eq(schema.profiles.userId, viewer.id)), columns: { id: true } })) {
  person = await getPublicPerson(handle, { hidden: true });
  preview = !!person;
}
if (!person) return new Response(null, { status: 404 });
if (preview) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
}

// logo, place and trust mark for the "Works at" cards (getPublicPerson only returns name and slug)
const slugs = person.companies.map((c) => c.slug);
const orgs = await inChunks(slugs, (slice) => db.select({ slug: schema.organizations.slug, logoKey: schema.organizations.logoKey, city: schema.organizations.city, country: schema.organizations.country, checkedAt: schema.organizations.identityCheckedAt })
  .from(schema.organizations).where(and(inArray(schema.organizations.slug, slice), eq(schema.organizations.published, true))));
const orgBySlug = new Map(orgs.map((o) => [o.slug, o]));
const companies = person.companies.map((c) => {
  const o = orgBySlug.get(c.slug);
  return { ...c, logoKey: o?.logoKey ?? null, place: place(o?.city, o?.country), checked: !!o?.checkedAt };
});

const where = place(person.city, person.country);
const skills = person.tags.skill;
const fields = [...industryLinks(person.tags.industry), ...subLinks(person.tags.sub)];
// the river rail on the left: one bead per part that is there (bio, skills), marking the parts only, so every bead stays at rest
const hasBio = !!person.bio;
const hasSkills = skills.length > 0;
const url = absolute(Astro.url.pathname, Astro.site);
const description = (person.headline ?? person.bio ?? `${person.name} on QuintaEarth`).replace(/\s+/g, ' ').slice(0, 160);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url,
  ...(person.headline && { jobTitle: person.headline }),
  ...(person.bio && { description: person.bio }),
  ...(person.photoKey && { image: absolute(fileUrl(person.photoKey), Astro.site) }),
  ...(where && { homeLocation: { '@type': 'Place', name: where } }),
  ...(companies.length && { worksFor: companies.map((c) => ({ '@type': 'Organization', name: c.name, url: absolute(page(`companies/${c.slug}`), Astro.site) })) }),
  ...(skills.length && { knowsAbout: skills }),
  ...((person.website || person.linkedin) && { sameAs: [person.website, person.linkedin].filter(Boolean) }),
};
---
<Member title={person.name} description={description} current="directory" noindex={preview}>
  <script slot="head" type="application/ld+json" set:html={ldJson(personLd)} />
  {preview && <div class="wide pp-preview"><p class="notice" role="status">Only you can see this page until you publish it.</p></div>}
  <PersonHead name={person.name} line={person.headline} imageKey={person.photoKey} where={where} website={person.website} linkedin={person.linkedin} />
  <section class="pp-body" aria-label="Profile">
    <div class="wide pp-two">
      {(hasBio || hasSkills) && (
        <div class="pp-spine">
          {hasBio && (
            <>
              <div class="pp-rail" aria-hidden="true"><span class="bead"></span><span class:list={['track', { tail: !hasSkills }]}></span></div>
              <div class:list={['pp-part', { last: !hasSkills }]}><p class="pp-bio">{person.bio}</p></div>
            </>
          )}
          {hasSkills && (
            <>
              <div class="pp-rail" aria-hidden="true"><span class="bead"></span><span class="track tail"></span></div>
              <div class="pp-part pp-sec last">
                <h2>Skills</h2>
                <div class="pp-chips">{skills.map((s) => <span class="chip">{s.charAt(0).toUpperCase() + s.slice(1)}</span>)}</div>
              </div>
            </>
          )}
        </div>
      )}
      {(companies.length > 0 || fields.length > 0) && (
        <div class="pp-side">
          {companies.length > 0 && (
            <section class="pp-sec">
              <h2>Works at</h2>
              <div class="pp-workats">
                {companies.map((c) => (
                  <a class="pp-workat" href={page(`companies/${c.slug}`)}>
                    <Avatar name={c.name} imageKey={c.logoKey} kind="company" size="sm" />
                    <span class="txt"><b>{c.name}</b>{c.place && <small>{c.place}</small>}{c.checked && <IdentityMark small />}</span>
                  </a>
                ))}
              </div>
            </section>
          )}
          {fields.length > 0 && (
            <section class="pp-sec">
              <h2>Industries</h2>
              <div class="pp-chips">{fields.map((f) => <a class="chip has" href={f.href}>{f.label}</a>)}</div>
            </section>
          )}
        </div>
      )}
    </div>
  </section>
  <div class="wide pp-end"></div>
</Member>

<style>
  /* the hidden profile's preview line (scoped here while the member CSS files are reworked for phones) */
  .pp-preview { padding-top: 20px; }
</style>
