---
// A story (design: "the spring", layouts/Spring.astro): the scene, the title on white with its dek, dateline and
// the line that says where it is filed (industry, sub-category, read time, UN goals), then the piece as the
// first stop on the river (lead photo, at a glance, the text near 70 characters a line), the record, the links
// and "More in <sub-category>" as the stops after it. Data, URL, SEO meta, structured data and every link are
// unchanged.
import '../../styles/spring-reading.css';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Spring from '../../layouts/Spring.astro';
import RiverRail from '../../components/spring/RiverRail.astro';
import Bead from '../../components/spring/Bead.astro';
import GoalTags from '../../components/page/GoalTags.astro';
import InsightCard from '../../components/page/InsightCard.astro';
import { getSub } from '../../data/industries';
import { site } from '../../data/site';
import { getStories, shortCompany, storySlug, storyToInsight, streamBySub } from '../../lib/content';
import { storyImage } from '../../lib/images';
import { absolute, page } from '../../lib/url';

export const getStaticPaths = (async () => {
  const stories = await getStories();
  const seen = new Set<string>();
  return stories.map((story) => {
    const slug = storySlug(story);
    if (seen.has(slug)) throw new Error(`Two stories share the URL "stories/${slug}"`);
    seen.add(slug);
    return { params: { slug }, props: { story } };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { story } = Astro.props;
const { data } = story;
const { Content } = await render(story);
const sub = getSub(data.sub);
const ind = sub.industry;
const self = storyToInsight(story);
const siblings = ((await streamBySub()).get(sub.slug) ?? []).filter((it) => it.id !== story.id);
const photo = storyImage(storySlug(story));
const share = photo ? await getImage({ src: photo, width: 1200, format: 'jpg' }) : undefined;

const description = data.dek.join(' ') || `${data.company}: ${data.product}`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description,
  about: { '@type': 'Organization', name: shortCompany(data.company) },
  keywords: data.tags.join(', '),
  timeRequired: `PT${self.minutes}M`,
  ...(share ? { image: absolute(share.src, Astro.site) } : {}),
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: absolute(page(`stories/${storySlug(story)}`), Astro.site),
  citation: data.sources,
};
const facts = [
  { label: 'Company', value: data.company },
  { label: 'Product', value: data.product },
  { label: 'Country', value: data.country },
  ...(data.launchDate ? [{ label: 'Milestones', value: data.launchDate }] : []),
];

// the stops after the piece, so the river's last bead falls on whichever comes last
const stops = ['record', data.links.length > 0 && 'links', siblings.length > 0 && 'more'].filter(Boolean) as string[];
const last = (stop: string) => stops[stops.length - 1] === stop;
---
<Spring title={data.title} description={description} imageUrl={share?.src} type="article" jsonLd={[ld]} current="industries"
  crumbs={[{ label: 'Industries', href: page('industries') }, { label: ind.name, icon: ind.icon, href: page(`industries-${ind.slug}`) }, { label: sub.name, href: page(sub.slug) }]}
  {...(photo && data.image ? { sceneImage: photo, sceneAlt: data.image.alt } : { scene: 'ins-ocean', sceneAlt: 'Fish swimming among drifting plastic under the surface of a blue sea' })} scenePos="50% 50%"
  say="Where sustainability is made, not performed." sub={`${shortCompany(data.company)} · ${data.country}`}>
  {data.dek.map((line) => <p class="rd-dek">{line}</p>)}
  {data.dateline && <p class="rd-dateline">{data.dateline}</p>}
  <div class="rd-meta">
    <p class="byline"><span>{self.minutes} min read</span></p>
    <GoalTags sdgs={data.sdgs} />
  </div>

  <RiverRail class="reading">
    <Bead />
    <article class="sp-stop rd-read" aria-label="Insight">
      {photo && data.image && (
        data.image.caption && <p class="rd-credit" set:html={data.image.caption} />
      )}
      {data.glance.length > 0 && (
        <aside class="rd-glance" aria-labelledby="glance-h">
          <h2 id="glance-h"><svg class="hi" aria-hidden="true"><use href="#hi-sprig" /></svg>At a glance</h2>
          <dl>{data.glance.map((g) => <><dt>{g.label}</dt><dd>{g.text}</dd></>)}</dl>
        </aside>
      )}
      <div class="rd-prose"><Content /></div>
    </article>

    <Bead last={last('record')} />
    <section class:list={['sp-stop', { end: last('record') }]} aria-labelledby="record-h">
      <h2 id="record-h">The record</h2>
      <div class="rd-foot">
        <dl class="record">{facts.map((f) => <><dt>{f.label}</dt><dd>{f.value}</dd></>)}</dl>
      </div>
    </section>

    {data.links.length > 0 && (
      <Bead last={last('links')} />
      <section class:list={['sp-stop', { end: last('links') }]} aria-labelledby="links-h">
        <h2 id="links-h">Links</h2>
        <p class="links">{data.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}<svg class="ic" aria-hidden="true"><use href="#i-arrow-up-right" /></svg></a>)}</p>
      </section>
    )}

    {siblings.length > 0 && (
      <Bead last />
      <section class="sp-stop end" aria-labelledby="more-h">
        <div class="rd-head"><h2 id="more-h">More in {sub.name}</h2><a class="tlink" href={page(sub.slug)}>All {siblings.length + 1} Insights<svg class="ic" aria-hidden="true"><use href="#i-arrow-right" /></svg></a></div>
        <div class="cards">{siblings.slice(0, 3).map((it) => <InsightCard item={it} showWhere={it.kind !== 'story'} />)}</div>
      </section>
    )}
  </RiverRail>
</Spring>
