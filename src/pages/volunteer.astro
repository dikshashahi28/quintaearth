---
// Volunteer (design: "the spring", layouts/Spring.astro): the form as the doors' form on the river rail, a bead
// per step (who you are, what you do, your résumé and why, send), each lit when its fields pass the form's own
// rules (scripts/volunteer-form.ts). Fields, ids, rules, endpoint and payload are unchanged from the old form.
import '../styles/spring-org.css';
import Spring from '../layouts/Spring.astro';
import GoButton from '../components/members/forms/GoButton.astro';
import Icon from '../components/members/Icon.astro';

const genders = [
  ['woman', 'Woman'],
  ['man', 'Man'],
  ['non-binary', 'Non-binary'],
  ['prefer-not-to-say', 'Prefer not to say'],
] as const;
// the four short text fields share one shape
const texts = [
  { id: 'designation', label: 'Designation', autocomplete: 'organization-title' },
  { id: 'education', label: 'Education', autocomplete: undefined },
  { id: 'city', label: 'City', autocomplete: 'address-level2' },
  { id: 'college', label: 'College', autocomplete: 'organization' },
] as const;
const pairs = [texts.slice(0, 2), texts.slice(2, 4)];
const rail = (ids: string, last = false) => ({ class: last ? 'qe-rail last' : 'qe-rail', 'data-for': ids });
---
<Spring current="volunteer" title="Volunteer with us" titleTag="Volunteer" description="Volunteer with QuintaEarth: join hands with us for a better life and beautiful future."
  scene="vol-stone"
  say="Join hands with us for a better life and beautiful future.">
  <section class="sp-form" aria-label="Volunteer form">
    <form class="qe-form" id="volunteer-form" action="#" method="post" enctype="multipart/form-data" novalidate>
      <div class="qe-grid">
        <div {...rail('volunteer-name volunteer-gender volunteer-phone volunteer-email')} aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step">
          <div class="row2">
            <div class="field">
              <label for="volunteer-name">Name</label>
              <input class="inp" id="volunteer-name" name="name" type="text" autocomplete="name" maxlength="80" required aria-describedby="volunteer-name-error">
              <p class="err" id="volunteer-name-error"></p>
            </div>
            <div class="field">
              <label for="volunteer-gender">Gender</label>
              <span class="selwrap">
                <select class="sel" id="volunteer-gender" name="gender" required aria-describedby="volunteer-gender-error">
                  <option value="">Choose one</option>
                  {genders.map(([value, label]) => <option value={value}>{label}</option>)}
                </select>
                <Icon name="expand_more" />
              </span>
              <p class="err" id="volunteer-gender-error"></p>
            </div>
          </div>
          <div class="row2">
            <div class="field">
              <label for="volunteer-phone">Phone number</label>
              <div class="phone">
                <button type="button" class="cc-btn" id="volunteer-cc-btn" aria-expanded="false" aria-controls="volunteer-cc-panel" aria-label="Country code, India plus 91">
                  <span id="volunteer-cc-flag" aria-hidden="true">🇮🇳</span>
                  <span id="volunteer-cc-dial">+91</span>
                  <svg class="ic" aria-hidden="true"><use href="#i-caret-down" /></svg>
                </button>
                <input class="inp" id="volunteer-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="12" required aria-describedby="volunteer-phone-error">
                <div class="cc-panel" id="volunteer-cc-panel" hidden>
                  <label class="sr" for="volunteer-cc-search">Search country</label>
                  <input class="inp" id="volunteer-cc-search" type="search" placeholder="Search country" autocomplete="off" spellcheck="false">
                  <ul id="volunteer-cc-list" aria-label="Countries"></ul>
                </div>
              </div>
              <p class="err" id="volunteer-phone-error"></p>
            </div>
            <div class="field">
              <label for="volunteer-email">Email</label>
              <input class="inp" id="volunteer-email" name="email" type="email" autocomplete="email" maxlength="100" spellcheck="false" required aria-describedby="volunteer-email-error">
              <p class="err" id="volunteer-email-error"></p>
            </div>
          </div>
        </div>

        <div {...rail('volunteer-designation volunteer-education volunteer-city volunteer-college')} aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step">
          {pairs.map((pair) => (
            <div class="row2">
              {pair.map((f) => (
                <div class="field">
                  <label for={`volunteer-${f.id}`}>{f.label}</label>
                  <input class="inp" id={`volunteer-${f.id}`} name={f.id} type="text" autocomplete={f.autocomplete} maxlength="80" required aria-describedby={`volunteer-${f.id}-error`}>
                  <p class="err" id={`volunteer-${f.id}-error`}></p>
                </div>
              ))}
            </div>
          ))}
        </div>

        <div {...rail('volunteer-resume volunteer-why volunteer-consent')} aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step">
          <div class="field">
            <label for="volunteer-resume">Resume</label>
            <input id="volunteer-resume" class="file" name="resume" type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required aria-describedby="volunteer-resume-hint volunteer-resume-error">
            <p class="hint" id="volunteer-resume-hint">PDF or Word (.doc, .docx)</p>
            <p class="err" id="volunteer-resume-error"></p>
          </div>
          <div class="field">
            <label for="volunteer-why">Why you want to volunteer</label>
            <textarea class="area" id="volunteer-why" name="why" rows="4" maxlength="400" required aria-describedby="volunteer-why-hint volunteer-why-error"></textarea>
            <p class="hint" id="volunteer-why-hint">20 to 400 characters.</p>
            <p class="err" id="volunteer-why-error"></p>
          </div>
          <div class="field">
            <label class="check" for="volunteer-consent">
              <input id="volunteer-consent" name="consent" type="checkbox" required aria-describedby="volunteer-consent-error">
              <span>I understand this is a volunteer signup, not a job application.</span>
            </label>
            <p class="err" id="volunteer-consent-error"></p>
          </div>
        </div>

        <div {...rail('*', true)} aria-hidden="true"><span class="bead"></span></div>
        <div class="qe-step end">
          <div class="acts">
            <GoButton label="Submit" />
            <p class="form-status" id="volunteer-status" role="status"></p>
          </div>
        </div>
      </div>
    </form>

    <div class="qe-grid" id="volunteer-thanks" tabindex="-1" hidden>
      <div class="qe-rail sent lit" aria-hidden="true"><span class="bead"></span></div>
      <div class="qe-sent" role="status">
        <h2>Thank you.</h2>
        <p>Our team will contact you soon.</p>
      </div>
    </div>
  </section>
</Spring>

<script>
  import { initVolunteerForm } from '../scripts/volunteer-form';
  initVolunteerForm();
</script>
