---
// Sign in (design: Sign in, "the spring") with email and password, or with Google. "?by=link" asks for a
// one-time email link instead: members who forgot their password choose a new one; a new address gets an account.
import { actions, isInputError } from 'astro:actions';
import Account from '../layouts/Account.astro';
import PasswordField from '../components/members/forms/PasswordField.astro';
import GoButton from '../components/members/forms/GoButton.astro';
import GoogleButton from '../components/members/forms/GoogleButton.astro';
import LinkedInButton from '../components/members/forms/LinkedInButton.astro';
import { actionErrorMessage } from '../components/members/forms/errors';
import InviteNote from '../components/members/forms/InviteNote.astro';
import { invitationFromNext } from '../components/members/forms/invitation';
import { readSent, rememberSent } from '../components/members/forms/sent';
import { googleSignIn, linkedinSignIn } from '../lib/auth';
import { page } from '../lib/url';

export const prerender = false;

if (Astro.locals.user) return Astro.redirect('/dashboard');

const params = Astro.url.searchParams;
const next = params.get('next') ?? '';
const linkError = params.get('error') === 'link';
// Google sends members back here when they cancel or the answer could not be used
const googleError = params.get('error') === 'google';
const linkedinError = params.get('error') === 'linkedin';
const signIn = Astro.getActionResult(actions.account.signIn);
if (signIn?.data) return Astro.redirect(signIn.data.next, 303);
// "Continue with Google": the action answers with Google's account chooser address
const google = Astro.getActionResult(actions.account.signInWithGoogle);
if (google?.data) return Astro.redirect(google.data.url, 303);
// "Continue with LinkedIn": the same, with LinkedIn's address
const linkedin = Astro.getActionResult(actions.account.signInWithLinkedIn);
if (linkedin?.data) return Astro.redirect(linkedin.data.url, 303);
const sendLink = Astro.getActionResult(actions.account.sendSignInLink);
// after sending, redirect to a plain page so a reload does not post (and email) again; the address rides in a
// short-lived cookie, never the URL (forms/sent.ts)
if (sendLink?.data) {
  let back = '';
  try { back = String((await Astro.request.formData()).get('next') ?? ''); } catch { back = ''; }
  rememberSent(Astro.cookies, { email: sendLink.data.email, name: '', type: '' }, Astro.url.protocol === 'https:');
  const q = new URLSearchParams({ by: 'link', sent: '1' });
  if (back) q.set('next', back);
  return Astro.redirect(`/signin?${q}`, 303);
}
const sent = params.get('sent') === '1' ? readSent(Astro.cookies) : null;
// ?sent=1 with no cookie: the note has timed out, so the form comes back
const timedOut = params.get('sent') === '1' && !sent;
const byLink = params.get('by') === 'link' || !!sendLink || linkError;
const result = byLink ? sendLink : (google ?? linkedin ?? signIn);
const fieldErrors: Record<string, string[] | undefined> = result?.error && isInputError(result.error) ? result.error.fields : {};
const failed = result?.error && !isInputError(result.error) ? actionErrorMessage(result.error) : null;

// the post goes to ?_action=…, so `next` comes from the form rather than the address
let formNext = next;
let formEmail = '';
if (result && Astro.request.method === 'POST') {
  try {
    const posted = await Astro.request.formData();
    formNext = String(posted.get('next') ?? '');
    formEmail = String(posted.get('email') ?? '').slice(0, 100);
  } catch { formNext = next; }
}
const withNext = (path: string, extra = '') => {
  const q = new URLSearchParams(extra);
  if (formNext) q.set('next', formNext);
  const s = q.toString();
  return s ? `${path}?${s}` : path;
};
// "Send it again" posts back to the sent page, so a refusal (the hourly limit) shows on the note, not on a fresh form
const againAction = `${withNext('/signin', 'by=link&sent=1')}&${actions.account.sendSignInLink.queryString.slice(1)}`;
const title = byLink ? 'Email me a link' : 'Sign in';
// on the way to a team invitation: say so, naming the company
const invite = await invitationFromNext(formNext);
---
<Account title={title} description="Sign in to QuintaEarth." scene="scene-signin"
  say="Where sustainability is made, not performed.">
  {!byLink && <p class="aside" slot="top"><span class="lead">New here?</span> <a href={withNext('/join')}>Create an account</a></p>}
  {byLink && sent ? (
    <div class="qe-form">
      <h1 class="tight">Email me a link</h1>
      <p class="lede">New here, or forgot your password? The link signs you in once, then you choose a password.</p>
      {failed && <p class="form-status bad" role="alert">{failed}</p>}
      <div class="qe-grid">
        <div class="qe-rail sent lit" aria-hidden="true"><span class="bead"></span></div>
        <div class="qe-sent">
          <div role="status">
            <h2>Check your email</h2>
            <p>We sent a link to <b>{sent.email}</b>. It works once and expires in 10 minutes.</p>
            <p>Not there? Check spam, or send it again.</p>
          </div>
          <form class="again" method="POST" action={againAction}>
            <input type="hidden" name="next" value={formNext}>
            <input type="hidden" name="email" value={sent.email}>
            <GoButton label="Send it again" pending="Sending…" line />
            <a class="tlink" href={withNext('/signin', 'by=link')}>Use another address</a>
          </form>
        </div>
      </div>
    </div>
  ) : byLink ? (
    <form class="qe-form" method="POST" action={actions.account.sendSignInLink}>
      <h1 class="tight">Email me a link</h1>
      <p class="lede">New here, or forgot your password? The link signs you in once, then you choose a password.</p>
      {invite && <InviteNote company={invite.company} />}
      {timedOut && <p class="notice" role="status">That page timed out. Enter your email again.</p>}
      {linkError && <p class="form-status bad" role="alert">That link has expired or was already used. Ask for a new one.</p>}
      {failed && <p class="form-status bad" role="alert">{failed}</p>}
      <input type="hidden" name="next" value={formNext}>
      <div class="qe-grid">
        <div class="qe-rail" data-for="link-email" aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step">
          <div class="field">
            <label for="link-email">Email</label>
            {/* the pattern wants a dot after the @, as the server does: the bead must not light beside an
                address the server would refuse */}
            <input class="inp" id="link-email" name="email" type="email" autocomplete="email" maxlength="100" required spellcheck="false" value={formEmail}
              pattern="[^@\s]+@[^@\s]+\.[^@\s]{2,}" title="An address like name@example.com"
              aria-invalid={fieldErrors.email ? 'true' : undefined} aria-describedby="link-email-error">
            <p class="err" id="link-email-error">{fieldErrors.email?.join(' ')}</p>
          </div>
        </div>
        <div class="qe-rail last" data-for="*" aria-hidden="true"><span class="bead"></span></div>
        <div class="qe-step end">
          <div class="acts"><GoButton label="Email me a link" pending="Sending…" /></div>
          <p class="small"><a class="tlink" href={withNext('/signin')}>Sign in with your password</a></p>
          <p class="small">By continuing you agree to our <a href={page('privacy')}>privacy notice</a>.</p>
        </div>
      </div>
    </form>
  ) : (
    <form class="qe-form" method="POST" action={actions.account.signIn}>
      <h1>Sign in</h1>
      {invite && <InviteNote company={invite.company} />}
      {googleError && <p class="form-status bad" role="alert">Google sign-in did not finish. Try again, or sign in with your email.</p>}
      {linkedinError && <p class="form-status bad" role="alert">LinkedIn sign-in did not finish. Try again, or sign in with your email.</p>}
      {failed && <p class="form-status bad" role="alert">{failed}</p>}
      <input type="hidden" name="next" value={formNext}>
      {/* Enter in a field presses the form's first submit button: this hidden one, not Google's (which skips the
          checks and posts elsewhere) */}
      <button class="sr" type="submit" tabindex="-1" aria-hidden="true">Sign in</button>
      <div class="qe-grid">
        {(googleSignIn || linkedinSignIn) && <>
          <div aria-hidden="true"></div>
          <div class="qe-step tight">
            {googleSignIn && <GoogleButton />}
            {linkedinSignIn && <LinkedInButton />}
            <p class="or" aria-hidden="true">or with your email</p>
          </div>
        </>}
        <div class="qe-rail" data-for="signin-email" aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step tight">
          <div class="field">
            <label for="signin-email">Email</label>
            <input class="inp" id="signin-email" name="email" type="email" autocomplete="username" maxlength="100" required spellcheck="false" value={formEmail}
              pattern="[^@\s]+@[^@\s]+\.[^@\s]{2,}" title="An address like name@example.com"
              aria-invalid={fieldErrors.email ? 'true' : undefined} aria-describedby="signin-email-error">
            <p class="err" id="signin-email-error">{fieldErrors.email?.join(' ')}</p>
          </div>
        </div>
        <div class="qe-rail" data-for="signin-email signin-password" aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step">
          <PasswordField id="signin-password" name="password" label="Password" autocomplete="current-password" error={fieldErrors.password} />
        </div>
        <div class="qe-rail last" data-for="*" aria-hidden="true"><span class="bead"></span></div>
        <div class="qe-step end">
          <div class="acts">
            <GoButton label="Sign in" pending="Signing in…" />
            <a class="tlink" href={withNext('/signin', 'by=link')}>Forgot your password?</a>
          </div>
        </div>
        <div aria-hidden="true"></div>
        <p class="qe-after">New to QuintaEarth? <a href={withNext('/join')}>Create an account</a></p>
      </div>
    </form>
  )}
</Account>
