---
// Not found (design: "the spring", layouts/Spring.astro): the direct ways back under the h1, then every industry
// as a chip beside one bead.
import '../styles/spring-goals.css';
import Spring from '../layouts/Spring.astro';
import RiverRail from '../components/spring/RiverRail.astro';
import Bead from '../components/spring/Bead.astro';
import { industries } from '../data/industries';
import { page } from '../lib/url';
---
<Spring title="Page not found" noindex
  scene="who-stone-3"
  say="This stretch of the river is dry." sub="The page you followed has moved or never existed">
  <div class="sp-ways">
    <a class="tlink" href={page('index')}>Home<svg class="ic" aria-hidden="true"><use href="#i-arrow-right" /></svg></a>
    <a class="tlink" href={page('insights')}>Insights<svg class="ic" aria-hidden="true"><use href="#i-arrow-right" /></svg></a>
    <a class="tlink" href={page('press')}>Press<svg class="ic" aria-hidden="true"><use href="#i-arrow-right" /></svg></a>
  </div>

  <RiverRail>
    <Bead last />
    <section class="sp-stop end" aria-labelledby="industries-h">
      <h2 id="industries-h"><a href={page('industries')}>All industries</a></h2>
      <ul class="chips">
        {industries.map((i) => <li><a class="chip" href={page(`industries-${i.slug}`)}>{i.name}</a></li>)}
      </ul>
    </section>
  </RiverRail>
</Spring>

<script>
  // links copied from a chat or email often pick up the punctuation after them: /energy-solar. or /about)
  const clean = location.pathname.replace(/[.,;:!?)\]'"]+$/, '');
  if (clean !== location.pathname) location.replace(clean + location.search + location.hash);
</script>
