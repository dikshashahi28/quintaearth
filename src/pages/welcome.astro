---
// First visit after sign-up (design: Welcome, "the spring"). Whatever sign-up did not collect is asked here:
// the name (Google and the sign-up form give it), the account type (the sign-up form gives it), the company name,
// and a password unless the member came in with Google. The middleware sends members here until they choose.
import { actions, isInputError } from 'astro:actions';
import { myCompanies, pendingInvites } from '../db/queries/dashboard';
import Account from '../layouts/Account.astro';
import Doors from '../components/members/forms/Doors.astro';
import GoButton from '../components/members/forms/GoButton.astro';
import PasswordField from '../components/members/forms/PasswordField.astro';
import { actionErrorMessage } from '../components/members/forms/errors';
import { signsInWithGoogle } from '../actions/account';

export const prerender = false;

// the middleware guards this page; the check is a second lock
const user = Astro.locals.user;
if (!user) return Astro.redirect('/signin?next=%2Fwelcome');
if (user.accountType) return Astro.redirect('/dashboard');

const result = Astro.getActionResult(actions.account.chooseAccountType);
if (result?.data) return Astro.redirect('/dashboard');
const errors = result?.error && isInputError(result.error) ? result.error.fields : {};
const failed = result?.error && !isInputError(result.error);
// joined a team by invitation: the account type is settled, only the name is asked
// an invitation not yet opened counts too: setup accepts it (see account.chooseAccountType)
const team = (await myCompanies(user.id))[0] ?? (await pendingInvites(user.email))[0];
// came in with Google: no password to choose (one can be set later on /dashboard/password)
const viaGoogle = await signsInWithGoogle(user.id);
// the library names new members after their email; offer an empty field instead. After a failed post, show
// what was typed (never the password).
let sent: FormData | null = null;
if (result?.error && Astro.request.method === 'POST') {
  try { sent = await Astro.request.formData(); } catch { sent = null; }
}
const knownName = user.name && user.name !== user.email.split('@')[0] ? user.name : '';
const nameValue = sent ? String(sent.get('name') ?? '') : knownName;
// the sign-up form's choice rides on the email link as ?type=
const given = Astro.url.searchParams.get('type');
const givenType = given === 'individual' || given === 'company' ? given : '';
const typeValue = sent ? String(sent.get('type') ?? '') : givenType;
const companyValue = sent ? String(sent.get('company') ?? '') : '';
// steps shown, in order: name (if not known), type (if not given and no team), company (type is or may be company), password
const askName = !knownName || !!sent?.get('name') && String(sent.get('name')) !== knownName;
const askType = !team && !givenType;
const askCompany = !team && typeValue !== 'individual';
const rails: string[] = [];
if (askName) rails.push('welcome-name');
if (askType) rails.push('type');
if (askCompany) rails.push(typeValue === 'company' ? 'welcome-company' : '');
if (!viaGoogle) rails.push('welcome-password');
---
<Account title="Welcome" description="Set up your QuintaEarth account." scene="solar-field" sceneAlt="Rows of solar panels across a farm, seen from above" scenePos="50% 50%"
  say="Where sustainability is made, not performed." sub="A few details and you are in">
  <form class="qe-form" method="POST" action={actions.account.chooseAccountType}>
    <h1 class="tight">Welcome to QuintaEarth</h1>
    <p class="signed">Signed in as {user.email}{viaGoogle ? ' with Google' : ''}</p>
    {failed && <p class="form-status bad" role="alert">{actionErrorMessage(result?.error)}</p>}
    {team && <p class="notice" role="status">You are joining {team.name}.</p>}
    {!askName && <input type="hidden" name="name" value={knownName}>}
    {!askType && givenType && <input type="hidden" name="type" value={givenType}>}
    <div class="qe-grid">
      {askName && <>
        <div class="qe-rail" data-for="welcome-name" aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step">
          <div class="field">
            <label for="welcome-name">Your name</label>
            <input class="inp" id="welcome-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required value={nameValue}
              aria-invalid={errors.name ? 'true' : undefined} aria-describedby="welcome-name-error">
            <p class="err" id="welcome-name-error">{errors.name?.join(' ')}</p>
          </div>
        </div>
      </>}
      {askType && <>
        <div class="qe-rail" data-for="type" aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step"><Doors value={typeValue} error={errors.type} /></div>
      </>}
      {askCompany && <>
        <div class="qe-rail" data-for={typeValue === 'company' ? 'welcome-company' : 'type welcome-company'} aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step">
          <div class="field">
            <label for="welcome-company">Company name {typeValue !== 'company' && <span class="opt">(companies only)</span>}</label>
            <input class="inp" id="welcome-company" name="company" type="text" autocomplete="organization" minlength="2" maxlength="120" required={typeValue === 'company'} value={companyValue}
              aria-invalid={errors.company ? 'true' : undefined} aria-describedby="welcome-company-error">
            <p class="err" id="welcome-company-error">{errors.company?.join(' ')}</p>
          </div>
        </div>
      </>}
      {!viaGoogle && <>
        <input class="sr" type="email" name="username" value={user.email} autocomplete="username" readonly tabindex="-1" aria-hidden="true">
        <div class="qe-rail" data-for="welcome-password" aria-hidden="true"><span class="bead"></span><span class="track"><span class="fill"></span></span></div>
        <div class="qe-step">
          <PasswordField id="welcome-password" name="password" label="Choose a password" autocomplete="new-password"
            hint="At least 10 characters. You sign in with it next time." error={errors.password} />
        </div>
      </>}
      <div class="qe-rail last" data-for="*" aria-hidden="true"><span class="bead"></span></div>
      <div class="qe-step end">
        <div class="acts"><GoButton label="Continue" /></div>
      </div>
    </div>
  </form>
</Account>
