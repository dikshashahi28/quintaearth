---
// The company's inbox: Open/Closed tabs and the list, a page at a time. No thread opens here: opening one (its own
// page) marks it read, and a thread shown beside the list while still marked new would say two things at once.
import Dashboard from '../../../layouts/Dashboard.astro';
import Inbox from '../../../components/members/enquiries/Inbox.astro';
import EmptyState from '../../../components/members/EmptyState.astro';
import { dashContext } from '../../../lib/dash-context';
import { inbox } from '../../../db/queries/dashboard';
import { listDate, pageLinks, showOf, withQuery } from '../../../components/members/enquiries/data';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect(`/signin?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
const ctx = await dashContext(user, Astro.url);
if (!ctx.company) return Astro.redirect('/dashboard');
const company = ctx.company;

const show = showOf(Astro.url);
const org = ctx.companies.length > 1 ? company.id : null;
const { rows, more, page, counts } = await inbox(company.id, show, Number(Astro.url.searchParams.get('page')));
const items = rows.map((e) => ({
  id: e.id, href: `/dashboard/enquiries/${e.id}`, source: e.fromCompany || 'Individual', date: listDate(e.updatedAt),
  name: e.fromName, subject: e.subject, isNew: e.companyUnread,
}));

const companyLink = company.published ? `/companies/${company.slug}` : `/dashboard/company${ctx.orgQuery}`;
---
<Dashboard ctx={ctx} current="enquiries" title="Enquiries" crumbs={[{ label: 'Enquiries' }]}>
  <Inbox show={show} openCount={counts.open} pager={pageLinks('/dashboard/enquiries', { org, show }, page, more)}
    tabs={{ open: withQuery('/dashboard/enquiries', { org }), closed: withQuery('/dashboard/enquiries', { org, show: 'closed' }) }}
    items={items} label="Enquiries" mode="list">
    <p class="eq-pick">Choose an enquiry to read it and reply.</p>
    <Fragment slot="empty">
      {counts.open + counts.closed === 0
        ? <EmptyState note="No enquiries yet." action={{ href: companyLink, label: company.published ? 'View your company page' : 'Finish your company page', quiet: true }} />
        : <EmptyState note={show === 'closed' ? 'No closed enquiries.' : 'No open enquiries.'} />}
    </Fragment>
  </Inbox>
</Dashboard>
