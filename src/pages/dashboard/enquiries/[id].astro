---
// One enquiry, opened by the company's team (the URL in "new enquiry" emails). Opening it marks it read.
// The list sits beside it on wide screens; on phone only the thread shows, with a link back.
import { actions, isInputError } from 'astro:actions';
import Dashboard from '../../../layouts/Dashboard.astro';
import Inbox from '../../../components/members/enquiries/Inbox.astro';
import Thread from '../../../components/members/enquiries/Thread.astro';
import { dashContext } from '../../../lib/dash-context';
import { actionErrorMessage } from '../../../components/members/forms/errors';
import { inbox, thread } from '../../../db/queries/dashboard';
import { authorNames, fieldError, inTab, listDate, listingName, withQuery } from '../../../components/members/enquiries/data';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect(`/signin?next=${encodeURIComponent(Astro.url.pathname)}`);
const id = Astro.params.id ?? '';

const replied = Astro.getActionResult(actions.enquiries.reply);
const status = Astro.getActionResult(actions.enquiries.setStatus);
if (replied?.data || status?.data) {
  const done = replied?.data ? 'reply' : status?.data?.status === 'closed' ? 'closed' : 'reopened';
  return Astro.redirect(`${Astro.url.pathname}?flash=${done}`, 303);
}
const err = replied?.error ?? status?.error;
const error = err
  ? isInputError(err) ? { body: fieldError(err.fields.body, 'Write a reply.'), form: err.fields.body ? undefined : 'Check the form and try again.' } : { form: actionErrorMessage(err) ?? undefined }
  : {};

const t = await thread(user.id, id);
if (!t) return new Response(null, { status: 404 });
if (t.side === 'buyer') return Astro.redirect(`/dashboard/messages/${id}`);

// the enquiry decides which of the member's companies is open
const url = new URL(Astro.url);
url.searchParams.set('org', t.enquiry.organizationId);
const ctx = await dashContext(user, url);
const company = ctx.company?.id === t.enquiry.organizationId ? ctx.company : null;
if (!company) return new Response(null, { status: 404 });

const all = await inbox(company.id);
// thread() has just marked it read; the fresh row has the current status
const enquiry = all.find((e) => e.id === id) ?? t.enquiry;
const show = enquiry.status === 'closed' ? 'closed' : 'open';
const org = ctx.companies.length > 1 ? company.id : null;
const items = all.filter((e) => inTab(e.status, show)).map((e) => ({
  id: e.id, href: `/dashboard/enquiries/${e.id}`, source: e.fromCompany || 'Individual', date: listDate(e.updatedAt),
  name: e.fromName, subject: e.subject, isNew: e.companyUnread,
}));
const [names, listing] = await Promise.all([authorNames(t.messages.map((m) => m.authorUserId)), listingName(enquiry.listingId)]);
const back = withQuery('/dashboard/enquiries', { org, show: show === 'closed' ? 'closed' : null });
---
<Dashboard ctx={ctx} current="enquiries" title={enquiry.subject} heading="Enquiries"
  crumbs={[{ label: 'Enquiries', href: withQuery('/dashboard/enquiries', { org }) }, { label: enquiry.subject }]}>
  <Inbox show={show} openCount={all.filter((e) => e.status !== 'closed').length}
    tabs={{ open: withQuery('/dashboard/enquiries', { org }), closed: withQuery('/dashboard/enquiries', { org, show: 'closed' }) }}
    items={items} currentId={id} label="Enquiries" mode="thread" backHref={back} backLabel="All enquiries">
    <Thread enquiry={enquiry} messages={t.messages} side="company" viewerId={user.id} companyName={company.name}
      listing={listing} names={names} base={`/dashboard/enquiries/${id}`} error={error} />
  </Inbox>
</Dashboard>
