---
// Set or change the password. Email links for known members land here (?next= carries where they were going),
// so a forgotten password is replaced right after the link signs them in.
import { actions, isInputError } from 'astro:actions';
import { and, eq } from 'drizzle-orm';
import { db, schema } from '../../db/client';
import Dashboard from '../../layouts/Dashboard.astro';
import PasswordField from '../../components/members/forms/PasswordField.astro';
import FormStatus from '../../components/members/forms/FormStatus.astro';
import { actionErrorMessage } from '../../components/members/forms/errors';
import { dashContext } from '../../lib/dash-context';
import { safeNext } from '../../lib/next';
import '../../styles/members/account.css';

export const prerender = false;

const user = Astro.locals.user;
const session = Astro.locals.session;
if (!user || !session) return Astro.redirect('/signin?next=%2Fdashboard%2Fpassword');

const raw = Astro.url.searchParams.get('next') ?? '';
const cleanNext = safeNext(raw, '');
const next = cleanNext.startsWith('/dashboard/password') ? '' : cleanNext;

const result = Astro.getActionResult(actions.account.setPassword);
if (result?.data) {
  if (!next) return Astro.redirect('/dashboard/password?saved=1', 303);
  // continuing into the dashboard: say the password was saved there
  const to = new URL(next, Astro.url);
  if (to.pathname.startsWith('/dashboard')) to.searchParams.set('flash', 'password');
  return Astro.redirect(`${to.pathname}${to.search}${to.hash}`, 303);
}
const errors: Record<string, string[] | undefined> = result?.error && isInputError(result.error) ? result.error.fields : {};
const failed = result?.error && !isInputError(result.error) ? actionErrorMessage(result.error) : null;

const ctx = await dashContext(user, Astro.url);
const hasPassword = !!(await db.query.account.findFirst({
  where: and(eq(schema.account.userId, user.id), eq(schema.account.providerId, 'credential')), columns: { password: true },
}))?.password;
// the same 15-minute rule as the action: a fresh sign-in needs no current password
const fresh = Date.now() - new Date(session.createdAt).getTime() < 15 * 60_000;
const askCurrent = hasPassword && !fresh;
const saved = Astro.url.searchParams.get('saved') ? 'Password saved. Use it next time you sign in.' : null;
const action = `${actions.account.setPassword}${next ? `&next=${encodeURIComponent(next)}` : ''}`;
---
<Dashboard ctx={ctx} current="password" title="Password" crumbs={[{ label: 'Password' }]}
  lede={hasPassword ? undefined : 'Choose a password. Next time you sign in with it, no email needed.'}>
  <FormStatus saved={saved} error={failed} />
  <form class="form pwform" method="POST" action={action}>
    <input class="sr" type="email" name="username" value={user.email} autocomplete="username" readonly tabindex="-1" aria-hidden="true">
    {askCurrent && <PasswordField id="pw-current" name="current" label="Current password" autocomplete="current-password" />}
    <PasswordField id="pw-new" name="password" label={hasPassword ? 'New password' : 'Password'} autocomplete="new-password"
      hint="At least 10 characters." error={errors.password} />
    <div class="form-send">
      <button class="btn btn-fill" type="submit">Save password</button>
      {next && hasPassword && <a class="tlink" href={next}>Keep my current password</a>}
    </div>
    {hasPassword && <p class="form-note">Saving signs you out on your other devices.</p>}
  </form>
</Dashboard>

<style>
  .pwform { max-width: 480px; }
  :global(.dmain > .notice), :global(.dmain > .form-status) { margin-bottom: 24px; }
</style>
