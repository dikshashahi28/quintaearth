---
// Testimonials (design: "the spring", layouts/Spring.astro): the reviews as the first stop on the river, then,
// when Google Sign-In is configured, the review form as the last. Ids, fields, rules and the endpoint are the
// ones scripts/reviews.ts has always used. Without a client id there is no form, only an email invitation.
import '../styles/spring-org.css';
import Spring from '../layouts/Spring.astro';
import RiverRail from '../components/spring/RiverRail.astro';
import Bead from '../components/spring/Bead.astro';
import GoButton from '../components/members/forms/GoButton.astro';
import { site } from '../data/site';

const clientId = String(import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ?? '').trim();
---
<Spring title="Testimonials" description="Reviews of QuintaEarth from the audience, clients, collaborators, startup owners and entrepreneurs."
  scene="who-stone-5"
  say="Reviews from audience, clients, collaborators, startup owners, and entrepreneurs.">
  {clientId && <script is:inline slot="head" src="https://accounts.google.com/gsi/client" async></script>}
  <RiverRail>
    <Bead last={!clientId} />
    <section class:list={['sp-stop', { end: !clientId }]} id="reviews" aria-label="Reviews" aria-busy="true">
      <p class="org-note" id="reviews-note">Loading reviews…</p>
      <ul class="reviews" id="reviews-list" aria-label="Reviews" hidden></ul>
      {!clientId && (
        <p class="org-mail-review">To leave a review, write to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      )}
    </section>

    {clientId && (
      <Bead last />
      <section class="sp-stop end" id="leave-review" data-client-id={clientId} aria-labelledby="leave-review-title">
        <h2 id="leave-review-title">Leave a review</h2>

        <div class="org-review">
          <div class="review-auth" id="review-auth">
            <p>Your Google email is saved with the review. It is not shown on the page.</p>
            <div id="review-google-btn" class="google-btn">
              <button type="button" class="btn btn-line" id="review-google-fallback">Sign in with Google</button>
            </div>
            <p class="form-status bad" id="review-auth-error" role="alert" hidden></p>
          </div>

          <div class="review-signed" id="review-signed" hidden>
            <p>Signed in as <b id="review-signed-email"></b></p>
            <button type="button" class="btn btn-line" id="review-signout">Sign out</button>
          </div>

          <form class="qe-form" id="review-form" action="#" method="post" novalidate hidden>
            <div class="row2">
              <div class="field">
                <label for="review-name">Name</label>
                <input class="inp" id="review-name" name="name" type="text" autocomplete="name" maxlength="80" required aria-describedby="review-name-error">
                <p class="err" id="review-name-error"></p>
              </div>
              <div class="field">
                <label for="review-designation">Designation / role</label>
                <input class="inp" id="review-designation" name="designation" type="text" autocomplete="organization-title" maxlength="80" required aria-describedby="review-designation-error">
                <p class="err" id="review-designation-error"></p>
              </div>
            </div>
            <div class="field">
              <label for="review-company">Company or place <span class="opt">(optional)</span></label>
              <input class="inp" id="review-company" name="company" type="text" autocomplete="organization" maxlength="80" aria-describedby="review-company-error">
              <p class="err" id="review-company-error"></p>
            </div>
            <fieldset class="field rate" id="review-rating" role="radiogroup" aria-required="true" aria-describedby="review-rating-error">
              <legend>Star rating</legend>
              <div class="rate-stars">
                {[1, 2, 3, 4, 5].map((n) => (
                  <label>
                    <input type="radio" name="rating" id={`review-star-${n}`} value={n} required={n === 1}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.7l2.35 7.23h7.6l-6.15 4.47 2.35 7.23L12 17.16l-6.15 4.47 2.35-7.23-6.15-4.47h7.6z" /></svg>
                    <span class="sr">{n === 1 ? '1 star' : `${n} stars`}</span>
                  </label>
                ))}
              </div>
              <p class="err" id="review-rating-error"></p>
            </fieldset>
            <div class="field">
              <label for="review-text">Review</label>
              <textarea class="area" id="review-text" name="review" rows="5" maxlength="400" required aria-describedby="review-text-hint review-text-error"></textarea>
              <p class="hint" id="review-text-hint">20 to 400 characters. <span id="review-count">0 / 400</span></p>
              <p class="err" id="review-text-error"></p>
            </div>
            <div class="acts">
              <GoButton label="Submit review" />
              <p class="form-status" id="review-status" role="status"></p>
            </div>
          </form>

          <div class="qe-sent" id="review-thanks" role="status" tabindex="-1" hidden>
            <h2>Thank you.</h2>
            <p>Your review is with us.</p>
          </div>
        </div>
      </section>
    )}
  </RiverRail>
</Spring>

<script>
  import { initReviews } from '../scripts/reviews';
  initReviews();
</script>
