---
// One page per UN goal (design: "the spring", layouts/Spring.astro): the goal is the UN's, read in the line the
// site has always carried for it; the page lists everything on QuintaEarth tagged with it, so a goal tag always
// leads somewhere, then the goal before and after.
import '../../styles/spring-goals.css';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Spring from '../../layouts/Spring.astro';
import RiverRail from '../../components/spring/RiverRail.astro';
import Bead from '../../components/spring/Bead.astro';
import InsightCard from '../../components/page/InsightCard.astro';
import { goals } from '../../data/sdgs';
import { getStream } from '../../lib/content';
import { page } from '../../lib/url';

export const getStaticPaths = (() => goals.map((goal, i) => ({ params: { n: String(goal.n) }, props: { goal, i } }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { goal, i } = Astro.props;

const items = (await getStream({ press: true })).filter((it) => it.sdgs.includes(goal.n));
const prev = goals[i - 1];
const next = goals[i + 1];
---
<Spring title={`Goal ${goal.n}: ${goal.title}`} crumbs={[{ label: 'UN goals', href: page('sdgs') }]} description={`${items.length} QuintaEarth Insights tagged with UN Sustainable Development Goal ${goal.n}, ${goal.title}. ${goal.line}`}
  scene="vol-arch"
  say={goal.line} sub={`UN Sustainable Development Goal ${goal.n}`}>
  <div class="sp-ways">
    <a class="tlink" href={goal.un} target="_blank" rel="noopener">The UN page for Goal {goal.n}<svg class="ic ext" aria-hidden="true"><use href="#i-arrow-up-right" /></svg></a>
  </div>

  <RiverRail>
    <Bead />
    <section class="sp-stop" aria-labelledby="tagged-h">
      <h2 id="tagged-h">Tagged with Goal {goal.n}</h2>
      {items.length
        ? <>
            <span class="count">{items.length} {items.length === 1 ? 'Insight' : 'Insights'}</span>
            <div class="cards">{items.map((it) => <InsightCard item={it} />)}</div>
          </>
        : <p class="empty-note">Nothing tagged with this goal yet.</p>}
    </section>

    <Bead last />
    <section class="sp-stop end" aria-labelledby="goals-h">
      <h2 id="goals-h">UN goals</h2>
      <nav class="gpager" aria-label="UN goals">
        {prev && <a class="prev" href={page(`sdgs/goal-${prev.n}`)}><span class="dir"><svg class="ic" aria-hidden="true"><use href="#i-arrow-left" /></svg>Goal {prev.n}</span><span class="t">{prev.title}</span></a>}
        {next && <a class="next" href={page(`sdgs/goal-${next.n}`)}><span class="dir">Goal {next.n}<svg class="ic" aria-hidden="true"><use href="#i-arrow-right" /></svg></span><span class="t">{next.title}</span></a>}
      </nav>
      <a class="tlink" href={page('sdgs')}>The 17 UN goals<svg class="ic" aria-hidden="true"><use href="#i-arrow-right" /></svg></a>
    </section>
  </RiverRail>
</Spring>
