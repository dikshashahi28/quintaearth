---
// One industry on the spring (layouts/Spring.astro): its own photo as the scene, the sub-categories to jump to
// under the h1, then a stop on the river per sub-category with its latest three Insights, the river ending at
// the previous/next pager. Slugs, links and meta are the 9 Oct rebuild's.
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import '../styles/spring-industries.css';
import Spring from '../layouts/Spring.astro';
import RiverRail from '../components/spring/RiverRail.astro';
import Bead from '../components/spring/Bead.astro';
import InsightCard from '../components/page/InsightCard.astro';
import { industries } from '../data/industries';
import { streamBySub } from '../lib/content';
import { page } from '../lib/url';

export const getStaticPaths = (() => industries.map((industry, i) => ({ params: { industry: industry.slug }, props: { industry, i } }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { industry: ind, i } = Astro.props;

const bySub = await streamBySub();
const ids = new Set(ind.subs.flatMap((s) => (bySub.get(s.slug) ?? []).map((it) => it.id)));
const prev = industries[i - 1];
const next = industries[i + 1];
---
<Spring title={ind.name} titleTag={`${ind.name} · Industries`} icon={ind.icon} crumbs={[{ label: 'Industries', href: page('industries') }]} description={`${ind.name}: ${ind.subs.map((s) => s.name).join(', ')}. ${ids.size} Insights filed.`} current="industries"
  scene={ind.image}
  say="Where sustainability is made, not performed." sub={`${ind.subs.length} sub-categories · ${ids.size} Insights`}>
  <ul class="chips sp-jump" aria-label="Jump to a sub-category">
    {ind.subs.map((s) => <li><a class="chip" href={`#${s.slug}`}>{s.name}</a></li>)}
  </ul>

  <RiverRail>
    {ind.subs.map((s) => {
      const list = bySub.get(s.slug) ?? [];
      return (
        <Bead />
        <section class="sp-stop" id={s.slug} aria-labelledby={`${s.slug}-h`}>
          <div class="sp-head">
            <h2 id={`${s.slug}-h`}><a href={page(s.slug)}>{s.name}</a></h2>
            <a class="tlink" href={page(s.slug)}>All {list.length} Insights<svg class="ic" aria-hidden="true"><use href="#i-arrow-right" /></svg></a>
          </div>
          {list.length
            ? <div class="cards">{list.slice(0, 3).map((it) => <InsightCard item={it} showWhere={it.kind !== 'story'} />)}</div>
            : <p class="empty-note">Nothing filed here yet.</p>}
        </section>
      );
    })}

    <Bead last />
    <div class="sp-stop end">
      <nav class="pager" aria-label="Industries">
        {prev && <a class="prev" href={page(`industries-${prev.slug}`)}><span class="dir"><svg class="ic" aria-hidden="true"><use href="#i-arrow-left" /></svg>Previous</span><span class="t">{prev.name}</span></a>}
        {next && <a class="next" href={page(`industries-${next.slug}`)}><span class="dir">Next<svg class="ic" aria-hidden="true"><use href="#i-arrow-right" /></svg></span><span class="t">{next.name}</span></a>}
      </nav>
    </div>
  </RiverRail>
</Spring>
