---
// The Insights stream (design: "the spring", layouts/Spring.astro): the scene, then two stops on the river: the
// stream with its filters (industry chips, a UN goal select, pages of 24 from scripts/insight-filters.ts; without
// JavaScript every card shows), and the press desk. Data, ids, URLs and the filter script are unchanged.
import '../styles/spring-reading.css';
import Spring from '../layouts/Spring.astro';
import RiverRail from '../components/spring/RiverRail.astro';
import Bead from '../components/spring/Bead.astro';
import InsightCard from '../components/page/InsightCard.astro';
import { getSub, industries } from '../data/industries';
import { goals } from '../data/sdgs';
import { getPress, getStream } from '../lib/content';
import { page } from '../lib/url';

const [items, press] = await Promise.all([getStream(), getPress()]);
const industryOf = (subs: string[]) => (subs[0] ? getSub(subs[0]).industry.slug : 'eu-rules');
const goalCount = (n: number) => items.filter((it) => it.sdgs.includes(n)).length;
const euCount = items.filter((it) => !it.subs.length).length;
const goalsServed = goals.filter((g) => goalCount(g.n)).length;
---
<Spring title="Insights" description={`${items.length} evidence-linked Insights on green industries: what companies make, what it proves, and which UN goals it serves.`} current="insights"
  scene="article-press-torque"
  say="Where sustainability is made, not performed." sub={`${items.length} Insights · ${industries.length} industries · ${goalsServed} UN goals`}>
  <RiverRail class="reading">
    <Bead />
    <section class="sp-stop" aria-labelledby="all-h">
      <h2 class="sr" id="all-h">All Insights</h2>
      <div class="filters" id="filters" hidden>
        <div class="chips" role="group" aria-label="Industry">
          <button class="chip on" type="button" data-industry="" aria-pressed="true">All</button>
          {industries.map((ind) => <button class="chip" type="button" data-industry={ind.slug} aria-pressed="false">{ind.name}</button>)}
          {euCount > 0 && <button class="chip" type="button" data-industry="eu-rules" aria-pressed="false">EU green-claims rules</button>}
        </div>
        <div class="filter-row">
          <label class="goal-select">
            <span>UN goal</span>
            {/* the counts are for the whole stream; the script recounts them for the chosen industry */}
            <select id="goalFilter">
              <option value="">All goals</option>
              {goals.filter((g) => goalCount(g.n)).map((g) => <option value={g.n} data-label={`Goal ${g.n}: ${g.title}`}>Goal {g.n}: {g.title} ({goalCount(g.n)})</option>)}
            </select>
          </label>
          <p class="result-count" id="resultCount" aria-live="polite">{items.length} Insights</p>
        </div>
      </div>
      <div class="cards" id="insightList">
        {items.map((it) => (
          <div class="card-slot" data-industry={industryOf(it.subs)} data-goals={` ${it.sdgs.join(' ')} `}>
            <InsightCard item={it} />
          </div>
        ))}
      </div>
      <p class="empty-note" id="noResults" hidden>No Insights match these filters. <a class="tlink" id="clearFilters" href={page('insights')}>Clear filters</a></p>
      <p class="more-row"><button class="btn btn-line" type="button" id="showMore" hidden>Show more</button></p>
    </section>

    <Bead last />
    <section class="sp-stop end" aria-labelledby="press-h">
      <div class="rd-head"><h2 id="press-h">Press desk notes</h2><a class="tlink" href={page('press')}>All {press.length} desk notes<svg class="ic" aria-hidden="true"><use href="#i-arrow-right" /></svg></a></div>
    </section>
  </RiverRail>
</Spring>

<script>
  import { initInsightFilters } from '../scripts/insight-filters';
  initInsightFilters();
</script>
