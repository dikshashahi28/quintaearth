---
import Page from '../layouts/Page.astro';
import PageHead from '../components/page/PageHead.astro';
import InsightCard from '../components/page/InsightCard.astro';
import { articleToInsight, getPress } from '../lib/content';
import { site } from '../data/site';

const press = (await getPress()).map(articleToInsight);
---
<Page current="press" title="Press releases" description="QuintaEarth press desk notes: public announcements in green industries, read for what they can prove.">
  <PageHead
    title="Press releases"
    crumbs={[{ label: 'Press' }]}
    lede="Public announcements in green industries, read for what they can prove."
    facts={[{ value: press.length, label: 'desk notes' }]}
  />
  <section class="page-body" aria-labelledby="notes-h">
    <div class="wide">
      <h2 class="sr" id="notes-h">Desk notes</h2>
      <div class="cards">{press.map((it) => <InsightCard item={it} />)}</div>
      <p class="press-mail">Press enquiries: <a href={`mailto:${site.pressEmail}`}>{site.pressEmail}</a></p>
    </div>
  </section>
</Page>
