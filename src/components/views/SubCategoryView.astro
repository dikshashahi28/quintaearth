---
// One sub-category on the spring (layouts/Spring.astro): its industry's photo as the scene, then two stops on
// the river: the Insights filed here, and the rest of the industry (its sub-categories as chips, the way to the
// whole industry, the previous/next pager). Rendered by pages/[slug].astro for the 46 pre-revamp URLs.
import '../../styles/spring-industries.css';
import Spring from '../../layouts/Spring.astro';
import RiverRail from '../spring/RiverRail.astro';
import Bead from '../spring/Bead.astro';
import InsightCard from '../page/InsightCard.astro';
import { allSubs, getSub } from '../../data/industries';
import { streamBySub } from '../../lib/content';
import { page } from '../../lib/url';

interface Props { slug: string }
const sub = getSub(Astro.props.slug);
const ind = sub.industry;
const bySub = await streamBySub();
const items = bySub.get(sub.slug) ?? [];

const i = allSubs.findIndex((s) => s.slug === sub.slug);
const prev = allSubs[i - 1];
const next = allSubs[i + 1];
const goals = new Set(items.flatMap((it) => it.sdgs));
const description = items.length
  ? `${sub.name} in ${ind.name}: ${items.length} evidence-linked Insights, from ${items.slice(0, 3).map((it) => it.title.split(':')[0]).join(', ')}.`
  : `${sub.name}, part of ${ind.name} on QuintaEarth.`;
---
<Spring title={sub.name} titleTag={`${sub.name} · ${ind.name}`} description={description} current="industries"
  crumbs={[{ label: 'Industries', href: page('industries') }, { label: ind.name, icon: ind.icon, href: page(`industries-${ind.slug}`) }]}
  scene={ind.image}
  say="Where sustainability is made, not performed." sub={`${items.length} ${items.length === 1 ? 'Insight' : 'Insights'} · ${goals.size} UN goals`}>
  <RiverRail>
    <Bead />
    <section class="sp-stop" aria-labelledby="insights-h">
      <h2 id="insights-h">Insights</h2>
      {items.length
        ? <div class="cards">{items.map((it) => <InsightCard item={it} showWhere={it.kind !== 'story'} />)}</div>
        : <p class="empty-note">Nothing filed here yet.</p>}
    </section>

    <Bead last />
    <section class="sp-stop end" aria-labelledby="more-h">
      <h2 id="more-h">More in {ind.name}</h2>
      <ul class="chips">
        {ind.subs.map((s) => {
          const n = bySub.get(s.slug)?.length ?? 0;
          const here = s.slug === sub.slug;
          return <li><a class:list={['chip', { has: n > 0 && !here, on: here }]} href={page(s.slug)} aria-current={here ? 'page' : undefined}>{s.name}{n > 0 && <> <i>{n}</i></>}</a></li>;
        })}
      </ul>
      <a class="tlink" href={page(`industries-${ind.slug}`)}>All of {ind.name}<svg class="ic" aria-hidden="true"><use href="#i-arrow-right" /></svg></a>
      <nav class="pager" aria-label="Sub-categories">
        {prev && <a class="prev" href={page(prev.slug)}><span class="dir"><svg class="ic" aria-hidden="true"><use href="#i-arrow-left" /></svg>Previous</span><span class="t">{prev.name}</span></a>}
        {next && <a class="next" href={page(next.slug)}><span class="dir">Next<svg class="ic" aria-hidden="true"><use href="#i-arrow-right" /></svg></span><span class="t">{next.name}</span></a>}
      </nav>
    </section>
  </RiverRail>
</Spring>
