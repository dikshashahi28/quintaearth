---
// An Insights essay or a press desk note (design: "the spring", layouts/Spring.astro): the scene, the title on
// white with the line that says where it is filed, its read time, date and UN goals, then the piece as the first
// stop on the river (lead photo, the text near 70 characters a line), the record (filed under, sources) and
// "Read next" as the stops after it. Data, URL, SEO meta, structured data and every link are unchanged.
import '../../styles/spring-reading.css';
import { render } from 'astro:content';
import Spring from '../../layouts/Spring.astro';
import RiverRail from '../spring/RiverRail.astro';
import Bead from '../spring/Bead.astro';
import GoalTags from '../page/GoalTags.astro';
import InsightCard from '../page/InsightCard.astro';
import { getSub } from '../../data/industries';
import { site } from '../../data/site';
import { type Article, articleToInsight, formatDate, getStream, isoDate, readMinutes } from '../../lib/content';
import { mediaShareUrl } from '../../lib/media';
import { absolute, asset, page } from '../../lib/url';

interface Props { article: Article }
const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);
const essay = article.collection === 'insights';
const list = essay ? { label: 'Insights', href: page('insights') } : { label: 'Press', href: page('press') };
const self = articleToInsight(article);

// read next: same sub-category or project first, then shared UN goals, then the newest
const stream = (await getStream({ press: true })).filter((it) => it.id !== article.id);
const score = (it: (typeof stream)[number]) =>
  (it.subs.some((s) => data.subs.includes(s)) ? 6 : 0) + it.sdgs.filter((n) => data.sdgs.includes(n)).length + (it.date ? 1 : 0);
const related = stream.map((it, i) => ({ it, s: score(it), i })).sort((a, b) => b.s - a.s || a.i - b.i).slice(0, 3).map((x) => x.it);

// the share image: the hero at 1200px, as an absolute URL for Open Graph and the structured data
const share = absolute(mediaShareUrl(data.image), Astro.site);
const ld = {
  '@context': 'https://schema.org',
  '@type': essay ? 'Article' : 'NewsArticle',
  headline: data.title,
  description: data.description,
  datePublished: isoDate(data.date),
  image: share,
  timeRequired: `PT${readMinutes(article.body)}M`,
  publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: absolute(asset('assets/logo.png'), Astro.site) } },
  mainEntityOfPage: absolute(page(article.id), Astro.site),
};

// the stops after the piece, so the river's last bead falls on whichever comes last
const filed = data.subs.length > 0 || data.euRules;
const stops = [filed && 'filed', data.sources.length > 0 && 'sources', related.length > 0 && 'next'].filter(Boolean) as string[];
const last = (stop: string) => stops[stops.length - 1] === stop;
// the source note sits under the sources, else under the filing, else under the piece
const noteIn = data.sources.length > 0 ? 'sources' : filed ? 'filed' : 'read';
---
<Spring title={data.title} crumbs={[list]} description={data.description} imageUrl={share} type="article" jsonLd={[ld]} current={essay ? 'insights' : 'press'}
  scene={data.image} sceneAlt={data.imageAlt}
  say="Where sustainability is made, not performed." sub={`${essay ? 'Insight' : 'Press desk note'} · ${formatDate(data.date)}`}>
  <div class="rd-meta">
    <p class="byline">
      <span>{self.minutes} min read</span>
      <span><time datetime={isoDate(data.date)}>{formatDate(data.date)}</time></span>
    </p>
    <GoalTags sdgs={data.sdgs} />
  </div>

  <RiverRail class="reading">
    <Bead last={stops.length === 0} />
    <article class:list={['sp-stop', 'rd-read', { end: stops.length === 0 }]} aria-label={essay ? 'Insight' : 'Desk note'}>
      <div class="rd-prose"><Content /></div>
      {data.note && noteIn === 'read' && <p class="rd-note">{data.note}</p>}
    </article>

    {filed && (
      <Bead last={last('filed')} />
      <section class:list={['sp-stop', { end: last('filed') }]} aria-labelledby="filed-h">
        <h2 id="filed-h">Filed under</h2>
        <ul class="chips">
          {data.subs.map((s) => <li><a class="chip has" href={page(s)}>{getSub(s).name}</a></li>)}
          {data.euRules && <li><span class="chip">EU green-claims rules, all industries</span></li>}
        </ul>
        {data.note && noteIn === 'filed' && <p class="rd-note">{data.note}</p>}
      </section>
    )}

    {data.sources.length > 0 && (
      <Bead last={last('sources')} />
      <section class:list={['sp-stop', { end: last('sources') }]} aria-labelledby="sources-h">
        <h2 id="sources-h">Sources</h2>
        <div class="rd-foot">
          <ol class="sources">{data.sources.map((u) => <li><a href={u} target="_blank" rel="noopener">{u}</a></li>)}</ol>
          {data.note && noteIn === 'sources' && <p class="rd-note">{data.note}</p>}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <Bead last />
      <section class="sp-stop end" aria-labelledby="related-h">
        <h2 id="related-h">Read next</h2>
        <div class="cards">{related.map((it) => <InsightCard item={it} />)}</div>
      </section>
    )}
  </RiverRail>
</Spring>
