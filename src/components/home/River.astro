---
// The river rail drawn down the home page as you scroll. Paths are built by scripts/river.ts from the
// positions of each section's [data-river] marker, so this is only the empty frame.
---
<svg class="river" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="riverGrad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2f6b3a" /><stop offset="1" stop-color="#2f6b3a" /></linearGradient>
    <mask id="riverMask" maskUnits="userSpaceOnUse" x="0" y="0" width="1" height="1"><path id="riverMaskPath" fill="none" stroke="#fff" stroke-width="16" stroke-linecap="round" d="" /></mask>
  </defs>
  <path id="riverWater" class="water" d="" />
  <path id="riverPath" class="main" d="" />
  <g id="riverCross"></g>
  <g class="current" mask="url(#riverMask)">
    <path id="riverFlow" class="flow" d="" />
    <path class="leaf" fill="#7fa26b" d="M0 -5 C 4 -5, 6 -1, 5 4 C 1 4, -2 1, 0 -5 Z"><animateMotion dur="52s" repeatCount="indefinite" rotate="auto"><mpath href="#riverPath" /></animateMotion></path>
    <path class="leaf" fill="#b8912f" d="M0 -4 C 3 -4, 5 -1, 4 3 C 1 3, -2 1, 0 -4 Z"><animateMotion dur="64s" begin="-21s" repeatCount="indefinite" rotate="auto"><mpath href="#riverPath" /></animateMotion></path>
    <path class="leaf" fill="#4d6e3d" d="M0 -5 C 4 -5, 6 -1, 5 4 C 1 4, -2 1, 0 -5 Z"><animateMotion dur="58s" begin="-40s" repeatCount="indefinite" rotate="auto"><mpath href="#riverPath" /></animateMotion></path>
  </g>
  <g id="riverDots"></g>
</svg>

<script>
  import { initRiver } from '../../scripts/river';
  initRiver();
</script>
