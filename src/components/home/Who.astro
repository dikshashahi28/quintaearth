---
import { site } from '../../data/site';
import Media from '../Media.astro';
import { page } from '../../lib/url';

// one photo per stone (src/data/media.json); the alt comes with the photo
const stones = [
  { img: 'who-stone-1', title: 'Scholars and students', line: 'Insights and press notes, filed by industry.', icon: 'book', cta: 'Start with Insights', href: page('insights') },
  { img: 'who-stone-2', title: 'Founders and professionals', line: 'A free community of people doing the same work.', icon: 'connect', cta: 'Join the community', href: site.whatsapp, external: true },
  { img: 'who-stone-3', title: 'Companies and exporters', line: 'Show your green work, each claim linked to proof.', icon: 'frame', cta: 'Show your work', href: page('our-work') },
  { img: 'who-stone-4', title: 'CSR teams and NGOs', line: 'CSR that goes beyond charity and plantations.', icon: 'sprout', cta: 'How we help with CSR', href: '#csr' },
  { img: 'who-stone-5', title: 'Makers and volunteers', line: 'Craft and clean-up projects that need hands.', icon: 'reed', cta: 'Volunteer with us', href: page('volunteer') },
];
---
<section class="who" id="who" data-river="stones">
  <div class="in wide">
    <p class="kicker rv"><svg class="hi" aria-hidden="true"><use href="#hi-sprig" /></svg><span class="num">01</span>Who it is for</p>
    <h2 class="rv">Five kinds of people, one river</h2>
    <p class="lede rv">Whatever your part in sustainability, there is a stop here for you.</p>
    <div class="stones">
      <ul id="stones">
        {stones.map((s) => (
          <li class="rv">
            <span class="stone" data-stop><Media name={s.img} sizes="(max-width: 640px) 80px, 106px" /></span>
            <h3>{s.title}</h3>
            <p>{s.line}</p>
            <a class="tag" href={s.href} {...(s.external ? { target: '_blank', rel: 'noopener' } : {})}>
              <svg class="hi" aria-hidden="true"><use href={`#hi-${s.icon}`} /></svg>{s.cta}{s.external && <span class="sr"> (opens in a new tab)</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
