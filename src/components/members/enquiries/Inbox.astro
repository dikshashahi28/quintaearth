---
// Two-pane inbox: Open/Closed tabs, the list on its river rail, and a thread (or a "choose one" note) beside it.
// Below 900px the panes stack: mode "list" shows only the list, mode "thread" only the thread. The way back is the
// page's breadcrumb, so the thread view carries no second back link and no tabs there.
import InboxList, { type InboxItem } from './InboxList.astro';
import type { Show } from './data';
import '../../../styles/members/enquiries.css';

interface Props {
  show: Show;
  tabs: Record<Show, string>;
  openCount: number;
  items: InboxItem[];
  currentId?: string;
  label: string;
  mode: 'list' | 'thread';
}
const { show, tabs, openCount, items, currentId, label, mode } = Astro.props;
---
<div class:list={['eq-tabs', `eq-tabs-${mode}`]} role="group" aria-label="Show">
  <a class:list={['chip', { on: show === 'open' }]} href={tabs.open} aria-current={show === 'open' ? 'true' : undefined}>Open{openCount > 0 && <i>{openCount}</i>}</a>
  <a class:list={['chip', { on: show === 'closed' }]} href={tabs.closed} aria-current={show === 'closed' ? 'true' : undefined}>Closed</a>
</div>
{items.length === 0
  ? <slot name="empty" />
  : (
    <div class:list={['eq-inbox', `eq-m-${mode}`]}>
      <InboxList items={items} currentId={currentId} label={label} />
      <div class="eq-pane"><slot /></div>
    </div>
  )}
