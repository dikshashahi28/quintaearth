---
// One labelled text input or textarea with its error line (aria-describedby) and, for limited text, a "used / max" count:
// rendered by the server, then kept up to date while the member types.
interface Props {
  id: string;
  name: string;
  label: string;
  value?: string | number | null;
  error?: string[];
  type?: 'text' | 'email' | 'url';
  textarea?: boolean;
  maxlength?: number;
  /** show "used / max" beside the label */
  count?: boolean;
  optional?: boolean;
  required?: boolean;
  autocomplete?: string;
  inputmode?: 'numeric' | 'email' | 'url' | 'text';
  placeholder?: string;
  hint?: string;
  rows?: number;
}
const { id, name, label, value, error, type = 'text', textarea = false, maxlength, count = false, optional = false, required = false,
  autocomplete, inputmode, placeholder, hint, rows } = Astro.props;
const v = value == null ? '' : String(value);
const errId = `${id}-error`;
const hintId = hint ? `${id}-hint` : undefined;
const described = [hintId, error?.length ? errId : undefined].filter(Boolean).join(' ') || undefined;
const attrs = {
  id, name, maxlength, required, autocomplete, placeholder,
  'aria-invalid': error?.length ? ('true' as const) : undefined,
  'aria-describedby': described,
};
---
<div class="field">
  {count && maxlength
    ? <div class="labrow"><label for={id}>{label}{optional && <span class="opt"> (optional)</span>}</label><span class="count" data-count-for={id}>{v.length} / {maxlength}</span></div>
    : <label for={id}>{label}{optional && <span class="opt"> (optional)</span>}</label>}
  {textarea
    ? <textarea class="area" rows={rows} {...attrs}>{v}</textarea>
    : <input class="inp" type={type} value={v} inputmode={inputmode} {...attrs} />}
  {hint && <p class="hint" id={hintId}>{hint}</p>}
  <p class="err" id={errId}>{error?.join(' ')}</p>
</div>
<script>
  // the count follows the text as it is typed (without JS it shows what was there at load)
  for (const count of document.querySelectorAll<HTMLElement>('.count[data-count-for]')) {
    const field = document.getElementById(count.dataset.countFor ?? '') as HTMLInputElement | HTMLTextAreaElement | null;
    if (!field) continue;
    const sync = () => { count.textContent = `${field.value.length} / ${field.maxLength}`; };
    field.addEventListener('input', sync);
    sync();
  }
  // a textarea grows with its text so nothing is hidden behind a scrollbar: CSS field-sizing where the browser
  // has it, otherwise measured here on load and as the member types
  if (!CSS.supports('field-sizing', 'content')) {
    for (const area of document.querySelectorAll<HTMLTextAreaElement>('textarea.area, textarea.eq-area')) {
      const grow = () => { area.style.height = 'auto'; area.style.height = `${area.scrollHeight + area.offsetHeight - area.clientHeight}px`; };
      area.addEventListener('input', grow);
      grow();
    }
  }
</script>
