---
// A password input with its error line and a Show button. The button needs JavaScript, so it stays hidden without it.
import Icon from '../Icon.astro';
interface Props {
  id: string;
  name: string;
  label: string;
  /** "current-password" on sign-in, "new-password" where one is chosen (lets password managers suggest one) */
  autocomplete: 'current-password' | 'new-password';
  error?: string[];
  hint?: string;
  required?: boolean;
}
const { id, name, label, autocomplete, error, hint, required = true } = Astro.props;
const errId = `${id}-error`;
const hintId = hint ? `${id}-hint` : undefined;
const described = [hintId, error?.length ? errId : undefined].filter(Boolean).join(' ') || undefined;
---
<div class="field">
  <label for={id}>{label}</label>
  <span class="pwwrap">
    <input class="inp" type="password" id={id} name={name} autocomplete={autocomplete} required={required}
      minlength={autocomplete === 'new-password' ? 10 : undefined} maxlength="128" spellcheck="false" autocapitalize="off"
      aria-invalid={error?.length ? 'true' : undefined} aria-describedby={described}>
    <button class="pwshow" type="button" aria-controls={id} aria-pressed="false" hidden>
      <Icon name="visibility" class="on" /><Icon name="visibility_off" class="off" /><span class="sr">Show password</span>
    </button>
  </span>
  {hint && <p class="hint" id={hintId}>{hint}</p>}
  <p class="err" id={errId}>{error?.join(' ')}</p>
</div>
<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.pwshow')) {
    const input = document.getElementById(btn.getAttribute('aria-controls')!) as HTMLInputElement | null;
    if (!input) continue;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.setAttribute('aria-pressed', String(show));
    });
  }
</script>
