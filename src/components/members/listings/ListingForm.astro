---
// The listing editor, shared by /dashboard/listings/new and /dashboard/listings/[id].
// The main form holds the details; slot "photo" sits after the name, slot "evidence" after the description.
// Upload controls in those slots belong to their own forms elsewhere on the page (`form` attribute) and carry
// the `data-autosave` mark: with script, a dirty listing is saved first so an upload never drops unsaved edits.
// The buttons belong to the main form through the `form` attribute.
import Icon from '../Icon.astro';
import '../../../styles/members/trust.css';
import ChipPicker from '../forms/ChipPicker.astro';
import { industries } from '../../../data/industries';
import { countries } from '../../../data/countries';
import { PRICING_OPTIONS } from '../../../lib/labels';
import { findGreenTerms, greenWarnings, listingGreenTexts } from '../../../lib/green-words';

export interface ListingValues {
  id?: string;
  name: string;
  kind: 'product' | 'service';
  description: string | null;
  link: string | null;
  status: 'draft' | 'published';
  pricingModel?: string | null;
  leadTime?: string | null;
  specs?: string | null;
  /** comma separated */
  tags?: string;
  /** ids of linked company certifications */
  certifications?: string[];
  /** the wording review: "pending" / "rejected" hold the listing from the public */
  greenReview?: string;
  greenReason?: string | null;
}
export interface CertOption { id: string; name: string; expired: boolean }
interface Props {
  /** form action URL (e.g. "?_action=listings.save") */
  action: string;
  organizationId: string;
  values: ListingValues;
  subs: string[];
  serves: string[];
  errors?: Record<string, string[] | undefined>;
  /** a non-field error from the last save */
  failure?: string;
  /** the company's certifications, to link */
  certOptions?: CertOption[];
}
const { action, organizationId, values, subs, serves, errors = {}, failure, certOptions = [] } = Astro.props;
// green wording: the owner sees why the listing is held, and the EmpCo warning on neutrality claims
const greenTexts = listingGreenTexts(values);
const greenTerms = findGreenTerms(...greenTexts);
const warnings = greenWarnings(...greenTexts);
const linked = new Set(values.certifications ?? []);
const isNew = !values.id;
const live = values.status === 'published';
const servesSet = new Set(serves);
// chosen countries show as chips; the rest fold under "Add countries"
const chosen = countries.filter((c) => servesSet.has(c.iso));
const rest = countries.filter((c) => !servesSet.has(c.iso)).sort((a, b) => a.name.localeCompare(b.name));
const err = (k: string) => errors[k]?.join(' ') ?? '';
---
<div class="formw">
  <form id="listing-form" class="sec" method="POST" action={action} data-status={values.status} novalidate>
    <h2>Listing</h2>
    {failure && <p class="form-status bad" role="alert">{failure}</p>}
    {values.greenReview === 'pending' && (
      <div class="gw gw-wait" role="status" data-green="pending">
        <Icon name="hourglass_top" />
        <div><b>In wording review</b><p>It uses “{greenTerms.join('”, “')}”, so it stays off your company page until we approve it. Evidence helps.</p></div>
      </div>
    )}
    {values.greenReview === 'rejected' && (
      <div class="gw gw-back" role="status" data-green="rejected">
        <Icon name="edit" />
        <div><b>Sent back by the wording review</b><p>{values.greenReason} Edit and save to send it again.</p></div>
      </div>
    )}
    {values.greenReview !== 'pending' && values.greenReview !== 'rejected' && greenTerms.length > 0 && <p class="hint gw-hint" data-green-hint>Words like “{greenTerms.join('”, “')}” send a listing to a short wording review before it is public.</p>}
    {warnings.map((w) => <p class="gw-warn" role="note" data-green-warning><Icon name="info" />{w.message}</p>)}
    <input type="hidden" name="organizationId" value={organizationId}>
    <input type="hidden" name="listingId" value={values.id ?? ''}>
    <div class="form">
      <fieldset class="field">
        <legend>Type</legend>
        <div class="seg">
          <label><input type="radio" name="kind" value="product" checked={values.kind === 'product'}>Product</label>
          <label><input type="radio" name="kind" value="service" checked={values.kind === 'service'}>Service</label>
        </div>
      </fieldset>
      <div class="field">
        <label for="l-name">Name</label>
        <input class="inp" id="l-name" name="name" type="text" maxlength="120" required value={values.name}
          aria-invalid={err('name') ? 'true' : undefined} aria-describedby="l-name-err">
        <p class="err" id="l-name-err">{err('name')}</p>
      </div>
      <slot name="photo" />
      <div class="field">
        <label for="l-desc">Short description</label>
        <textarea class="area short" id="l-desc" name="description" maxlength="2000"
          aria-invalid={err('description') ? 'true' : undefined} aria-describedby="l-desc-err">{values.description ?? ''}</textarea>
        <p class="err" id="l-desc-err">{err('description')}</p>
      </div>
      <div class="row2">
        <div class="field">
          <label for="l-pricing">Pricing <span class="opt">(optional)</span></label>
          <span class="selwrap">
            <select class="sel" id="l-pricing" name="pricingModel" aria-describedby="l-pricing-err">
              <option value="" selected={!values.pricingModel}>Not shown</option>
              {PRICING_OPTIONS.map((o) => <option value={o.value} selected={values.pricingModel === o.value}>{o.label}</option>)}
            </select>
            <Icon name="expand_more" />
          </span>
          <p class="err" id="l-pricing-err">{err('pricingModel')}</p>
        </div>
        <div class="field">
          <label for="l-lead">Lead time or availability <span class="opt">(optional)</span></label>
          <input class="inp" id="l-lead" name="leadTime" type="text" maxlength="80" value={values.leadTime ?? ''} placeholder="4 to 6 weeks"
            aria-invalid={err('leadTime') ? 'true' : undefined} aria-describedby="l-lead-err">
          <p class="err" id="l-lead-err">{err('leadTime')}</p>
        </div>
      </div>
      <div class="field">
        <label for="l-specs">Specifications <span class="opt">(optional)</span></label>
        <textarea class="area short" id="l-specs" name="specs" maxlength="3000"
          aria-invalid={err('specs') ? 'true' : undefined} aria-describedby="l-specs-err">{values.specs ?? ''}</textarea>
        <p class="err" id="l-specs-err">{err('specs')}</p>
      </div>
      <div class="field">
        <label for="l-tags">Tags <span class="opt">(optional)</span></label>
        <input class="inp" id="l-tags" name="tags" type="text" maxlength="400" value={values.tags ?? ''} placeholder="Solar pump, off-grid"
          aria-invalid={err('tags') ? 'true' : undefined} aria-describedby="l-tags-hint l-tags-err">
        <p class="hint" id="l-tags-hint">Separate with commas. People can search by them.</p>
        <p class="err" id="l-tags-err">{err('tags')}</p>
      </div>
      {certOptions.length > 0 && (
        <ChipPicker name="certifications" legend="Certifications" selected={[...linked]} errorId="l-certs-err" error={errors.certifications}
          options={certOptions.map((c) => ({ value: c.id, label: c.expired ? `${c.name} (expired)` : c.name }))} />
      )}
      <slot name="evidence" />
      <ChipPicker name="subs" legend="Sub-categories" selected={subs} errorId="l-subs-err" error={errors.subs}
        groups={industries.map((ind) => ({ label: ind.name, options: ind.subs.map((s) => ({ value: s.slug, label: s.name })) }))} />
      <ChipPicker name="serves" legend="Countries served" selected={serves} errorId="l-serves-err" error={errors.serves}
        options={chosen.map((c) => ({ value: c.iso, label: c.name }))}
        groups={[{ label: 'Add countries', options: rest.map((c) => ({ value: c.iso, label: c.name })) }]} />
      <div class="field">
        <label for="l-link">Link <span class="opt">(optional)</span></label>
        <input class="inp" id="l-link" name="link" type="text" inputmode="url" maxlength="300" value={values.link ?? ''}
          aria-invalid={err('link') ? 'true' : undefined} aria-describedby="l-link-err">
        <p class="err" id="l-link-err">{err('link')}</p>
      </div>
    </div>
  </form>

  <section class="sec">
    <div class="form-send">
      {live ? (<>
        <button class="btn btn-fill" type="submit" form="listing-form" name="status" value="published">Save changes</button>
        <button class="btn btn-line" type="submit" form="listing-form" name="status" value="draft" aria-describedby="l-unpub">Unpublish</button>
        <p class="hint" id="l-unpub">It leaves your company page.</p>
      </>) : (<>
        <button class="btn btn-line" type="submit" form="listing-form" name="status" value="draft">Save draft</button>
        <button class="btn btn-fill" type="submit" form="listing-form" name="status" value="published">Publish</button>
      </>)}
      {!isNew && <slot name="send" />}
    </div>
  </section>
</div>

<script>
  // Save a changed listing before an upload or a file removal reloads the page, so those edits are kept.
  // (forms/save-first.ts drops the clicked button, which carries `status` here and the file key on removal.)
  import { snapshot } from '../forms/save-first';
  const main = document.getElementById('listing-form') as HTMLFormElement | null;
  if (main) {
    let base = snapshot(new FormData(main));
    let busy = false;
    for (const f of document.querySelectorAll<HTMLFormElement>('form[data-autosave]')) {
      f.addEventListener('submit', async (e) => {
        if (f.dataset.saved) return;
        if (busy) { e.preventDefault(); return; }
        if (snapshot(new FormData(main)) === base) return;
        e.preventDefault();
        busy = true;
        const status = main.dataset.status ?? 'draft';
        const fd = new FormData(main);
        fd.set('status', status);
        // a good save redirects to ?saved=1; a failed one renders the page again
        const ok = await fetch(main.action, { method: 'POST', body: fd }).then((r) => new URL(r.url).searchParams.has('saved'), () => false);
        busy = false;
        if (ok) {
          base = snapshot(new FormData(main));
          f.dataset.saved = '1';
          f.requestSubmit(e.submitter as HTMLElement | null);
        } else {
          // post the edits the normal way so the errors show next to the fields
          main.requestSubmit(document.querySelector<HTMLButtonElement>(`button[form="listing-form"][value="${status}"]`));
        }
      });
    }
  }
</script>
