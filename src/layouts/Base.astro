---
import '../styles/base.css';
import IconSprite from '../components/IconSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, type NavKey } from '../data/site';
import { absolute, asset } from '../lib/url';

interface Props {
  /** page title without the site name; omit on the home page */
  title?: string;
  description?: string;
  /** path under /public for the share image */
  image?: string;
  /** an already-resolved share image URL (e.g. from getImage), used instead of `image` */
  imageUrl?: string;
  type?: 'website' | 'article';
  /** structured data objects, emitted as JSON-LD */
  jsonLd?: Record<string, unknown>[];
  /** nav item to mark as current */
  current?: NavKey;
  noindex?: boolean;
  /** extra class on <main>, e.g. "flow" for the river on the home page */
  mainClass?: string;
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  imageUrl,
  type = 'website',
  jsonLd = [],
  current,
  noindex = false,
  mainClass,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · One hub for sustainability, green tech and clean tech`;
// canonical URLs are clean: "/" not "/index.html", "/about" not "/about.html"
const canonical = absolute(Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, ''), Astro.site);
const ogImage = absolute(imageUrl ?? asset(image), Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:site_name" content={site.name}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={type}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#f6f9f1">
  <link rel="icon" href={asset('favicon.ico')} sizes="any">
  <link rel="sitemap" href={asset('sitemap.xml')}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;1,7..72,400&family=Public+Sans:wght@400;500;600&display=swap">
  {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  <slot name="head" />
</head>
<body>
  <IconSprite />
  <a class="skip" href="#main">Skip to content</a>
  <Header current={current} />
  <main id="main" class={mainClass}>
    <slot />
  </main>
  <Footer />
  <script>
    import { initReveal } from '../scripts/reveal';
    initReveal();
  </script>
</body>
</html>
