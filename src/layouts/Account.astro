---
// The account pages (sign up, sign in, welcome): a full-screen split with no site header. Photo and river on the
// left, the form on the right. Design: "the spring" comp (styles/members/spring.css).
import '../styles/base.css';
import '../styles/members.css';
import '../styles/members/account.css';
import '../styles/members/spring.css';
import FormFocus from '../components/members/forms/FormFocus.astro';
import SpringScene from '../components/spring/SpringScene.astro';
import { site } from '../data/site';
import { asset, page } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** a site photograph by name (src/data/media.json), of people doing the work */
  scene: string;
  /** the photo's own alt when unset */
  sceneAlt?: string;
  /** object-position for the photo; the photo's own focal point when unset */
  scenePos?: string;
  /** object-position for the short band at 1100px and below; scenePos when unset */
  scenePosSm?: string;
  /** the line on the photo */
  say: string;
  /** a gold line under it */
  sub?: string;
}
const { title, description, scene, sceneAlt, scenePos, scenePosSm, say, sub } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title} · {site.name}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#14301c">
  <link rel="icon" href={asset('favicon.ico')} sizes="any">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;1,7..72,400&family=Public+Sans:wght@400;500;600&display=swap">
</head>
<body>
  <div class="qe-root">
    <SpringScene scene={scene} sceneAlt={sceneAlt} scenePos={scenePos} scenePosSm={scenePosSm} sizes="(max-width: 1100px) 100vw, 50vw" say={say} sub={sub} />
    <main class="qe-pane" id="main">
      <header class="qe-top">
        <a class="logo" href={page('index')}><img src={asset('assets/logo.png')} alt="QuintaEarth" width="600" height="127"></a>
        <slot name="top" />
      </header>
      <div class="qe-body">
        <slot />
      </div>
    </main>
  </div>
  <FormFocus />
  <script>
    // the river rail: each rail names the controls of its step (data-for="id id"); the bead lights and the track
    // fills when they are all filled in and valid. "data-for='*'" is the send step: lit when the whole form is.
    const rails = [...document.querySelectorAll<HTMLElement>('.qe-rail[data-for]')];
    // a field the server sent back as invalid stays unlit until it is edited (a value put back by the server skips
    // the browser's length checks, so checkValidity alone would light it next to its error)
    const edited = new WeakSet<EventTarget>();
    const flagged = (i: Element) => i.getAttribute('aria-invalid') === 'true' && !edited.has(i);
    const update = () => {
      for (const rail of rails) {
        const form = rail.closest('form');
        const ids = rail.dataset.for!.split(/\s+/).filter(Boolean);
        const ok = ids[0] === '*'
          ? !!form && form.checkValidity() && [...form.querySelectorAll<HTMLInputElement>('input[required]:not([type=radio])')].every((i) => i.value.trim() !== '')
            && ![...form.querySelectorAll('[aria-invalid="true"]')].some(flagged)
          : ids.every((id) => {
              const els = [...document.querySelectorAll<HTMLInputElement>(`#${CSS.escape(id)}, input[name="${CSS.escape(id)}"]`)];
              if (!els.length) return false;
              if (els[0]!.type === 'radio') return els.some((r) => r.checked);
              return els.every((i) => i.value.trim() !== '' && i.checkValidity() && !flagged(i));
            });
        rail.classList.toggle('lit', ok);
        rail.classList.toggle('on', ok);
      }
    };
    for (const form of document.querySelectorAll('form')) {
      form.addEventListener('input', (e) => { if (e.target) edited.add(e.target); update(); });
      form.addEventListener('change', update);
    }
    update();
  </script>
</body>
</html>
