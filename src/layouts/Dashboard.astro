---
// Every /dashboard page: a plain white head (trail, optional portrait, title, lede), then the dashboard nav beside
// the page's own content. Design: "the spring" Dashboard board (styles/members/dashboard.css).
import Page from './Page.astro';
import type { Crumb } from '../components/page/PageHead.astro';
import DashNav, { type DashKey } from '../components/members/DashNav.astro';
import Avatar from '../components/members/Avatar.astro';
import type { DashContext } from '../lib/dash-context';
import { page } from '../lib/url';
import '../styles/members.css';
import '../styles/members/dashboard.css';
import FormFocus from '../components/members/forms/FormFocus.astro';

interface Props {
  ctx: DashContext;
  current: DashKey;
  /** page title; also the h1 unless `heading` is given */
  title: string;
  heading?: string;
  lede?: string;
  /** trail after Home > Dashboard; omit on the dashboard home */
  crumbs?: Crumb[];
  /** the member's portrait beside the heading (dashboard home) */
  avatar?: { name: string; imageKey?: string | null };
}
const { ctx, current, title, heading, lede, crumbs, avatar } = Astro.props;
// one-line confirmations after a redirect (?flash=<key>), for actions whose page has no notice of its own
const FLASH: Record<string, string> = {
  reply: 'Reply sent.',
  closed: 'Marked as closed.',
  reopened: 'Reopened.',
  identity: 'Request sent. We email you when it is decided.',
  joined: ctx.company ? `You joined ${ctx.company.name}.` : 'You joined the team.',
  password: 'Password saved. Use it next time you sign in.',
};
const flash = FLASH[Astro.url.searchParams.get('flash') ?? ''];
const trail: Crumb[] = [{ label: 'Home', href: page('index') }, ...(crumbs ? [{ label: 'Dashboard', href: '/dashboard' }, ...crumbs] : [{ label: 'Dashboard' }])];
---
<Page title={title} description="Your QuintaEarth dashboard." noindex>
  <header class="page-head dhead">
    <div class="wide">
      <nav class="dcrumbs" aria-label="Breadcrumb">
        <ol>
          {trail.map((c, i) => (
            <li>{i > 0 && <span class="sep" aria-hidden="true">›</span>}{i < trail.length - 1 && c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class="dhead-row">
        {avatar && <span class="dhead-av" aria-hidden="true"><Avatar name={avatar.name} imageKey={avatar.imageKey} size="sm" /></span>}
        <div class="dhead-txt">
          <h1>{heading ?? title}</h1>
          {lede && <p class="lede">{lede}</p>}
        </div>
      </div>
      <slot name="head" />
    </div>
  </header>
  <div class="wide dash">
    <div class="dslot"><DashNav current={current} company={!!ctx.company} newEnquiries={ctx.newEnquiries} newReplies={ctx.newReplies} orgQuery={ctx.orgQuery} /></div>
    <div class="dmain">{flash && <p class="notice flash" role="status">{flash}</p>}<slot /></div>
  </div>
  <div class="wide dash-end"></div>
  <FormFocus />
</Page>
