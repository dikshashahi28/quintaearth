// Cloudflare Workers static site: `pnpm build` writes dist/, `npx wrangler deploy` uploads it.
// dist/_redirects and dist/_headers are read by Cloudflare as they are on Pages.
{
  "name": "quintaearth",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
